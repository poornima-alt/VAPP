<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>VAPP | Security Command Center</title>

<style>

/* =========================================================
   VAPP COMMAND CENTER
   Futuristic 3D / Glassmorphism UI
========================================================= */

* {
    box-sizing: border-box;
}

:root {
    --bg: #020711;
    --panel: rgba(7, 20, 37, 0.82);
    --panel2: rgba(10, 29, 50, 0.72);
    --border: rgba(56, 189, 248, 0.25);

    --cyan: #38bdf8;
    --blue: #1683ff;
    --green: #22c55e;
    --yellow: #facc15;
    --orange: #fb923c;
    --red: #ef4444;

    --text: #e8f7ff;
    --muted: #7890a8;
}


/* =========================================================
   BODY
========================================================= */

body {

    margin: 0;

    min-height: 100vh;

    font-family:
        "Segoe UI",
        Arial,
        sans-serif;

    color: var(--text);

    background:

        radial-gradient(
            circle at 15% 15%,
            rgba(0, 153, 255, 0.14),
            transparent 25%
        ),

        radial-gradient(
            circle at 85% 30%,
            rgba(0, 90, 255, 0.12),
            transparent 25%
        ),

        radial-gradient(
            circle at 50% 100%,
            rgba(0, 190, 255, 0.07),
            transparent 30%
        ),

        #020711;

    overflow-x: hidden;
}


/* =========================================================
   BACKGROUND CIRCUIT EFFECT
========================================================= */

body::before {

    content: "";

    position: fixed;

    inset: 0;

    pointer-events: none;

    opacity: 0.25;

    background-image:

        linear-gradient(
            rgba(56,189,248,0.035) 1px,
            transparent 1px
        ),

        linear-gradient(
            90deg,
            rgba(56,189,248,0.035) 1px,
            transparent 1px
        );

    background-size: 45px 45px;

    z-index: -1;
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {

    position: fixed;

    left: 0;
    top: 0;
    bottom: 0;

    width: 235px;

    padding: 22px 14px;

    background:
        linear-gradient(
            180deg,
            rgba(3,14,28,.97),
            rgba(2,8,17,.97)
        );

    border-right:
        1px solid
        rgba(56,189,248,.18);

    box-shadow:
        10px 0 40px
        rgba(0,0,0,.45);

    z-index: 100;
}


/* =========================================================
   BRAND
========================================================= */

.brand {

    text-align: center;

    padding-bottom: 22px;

    margin-bottom: 22px;

    border-bottom:
        1px solid
        rgba(56,189,248,.15);
}


.shield-logo {

    width: 65px;

    height: 65px;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 39px;

    border-radius: 20px;

    background:
        linear-gradient(
            145deg,
            #0b4d78,
            #031b32
        );

    border:
        1px solid
        rgba(56,189,248,.65);

    box-shadow:

        0 0 20px
        rgba(56,189,248,.35),

        inset 0 0 20px
        rgba(56,189,248,.12);

    transform:
        perspective(500px)
        rotateX(8deg);

}


.brand-name {

    margin-top: 12px;

    font-size: 27px;

    font-weight: 900;

    letter-spacing: 3px;

    color: var(--cyan);

    text-shadow:
        0 0 15px
        rgba(56,189,248,.6);
}


.brand-sub {

    margin-top: 4px;

    font-size: 8px;

    color: var(--muted);

    letter-spacing: 1.7px;
}


/* =========================================================
   NAVIGATION
========================================================= */

.nav {

    display: flex;

    flex-direction: column;

    gap: 6px;
}


.nav-item {

    padding: 13px 14px;

    border-radius: 10px;

    display: flex;

    align-items: center;

    gap: 13px;

    color: #8198ad;

    font-size: 13px;

    transition: .25s;

    border-left:
        3px solid
        transparent;
}


.nav-item:hover {

    background:
        rgba(56,189,248,.08);

    color: white;
}


.nav-item.active {

    color: white;

    border-left:
        3px solid
        var(--cyan);

    background:
        linear-gradient(
            90deg,
            rgba(14,165,233,.22),
            rgba(14,165,233,.03)
        );

    box-shadow:
        inset 0 0 20px
        rgba(56,189,248,.04);
}


.nav-icon {

    width: 23px;

    text-align: center;

    font-size: 18px;
}


/* =========================================================
   MAIN
========================================================= */

.main {

    margin-left: 235px;

    min-height: 100vh;
}


/* =========================================================
   TOPBAR
========================================================= */

.topbar {

    height: 72px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 28px;

    position: sticky;

    top: 0;

    z-index: 50;

    background:
        rgba(2,10,20,.82);

    backdrop-filter:
        blur(18px);

    border-bottom:
        1px solid
        rgba(56,189,248,.15);
}


.search {

    width: 300px;

    padding: 11px 15px;

    border-radius: 25px;

    background:
        rgba(8,26,44,.75);

    border:
        1px solid
        rgba(56,189,248,.2);

    color: #7890a8;

    font-size: 11px;
}


.top-right {

    display: flex;

    align-items: center;

    gap: 22px;
}


.system {

    display: flex;

    align-items: center;

    gap: 8px;

    padding: 8px 13px;

    border-radius: 20px;

    background:
        rgba(34,197,94,.06);

    border:
        1px solid
        rgba(34,197,94,.25);

    color: #4ade80;

    font-size: 10px;

    font-weight: bold;
}


.system-dot {

    width: 8px;

    height: 8px;

    border-radius: 50%;

    background: var(--green);

    box-shadow:
        0 0 12px
        var(--green);

    animation:
        pulse 1.5s infinite;
}


@keyframes pulse {

    0%,100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: .45;
        transform: scale(.75);
    }
}


.user {

    display: flex;

    align-items: center;

    gap: 10px;

    font-size: 12px;

    color: #b4c5d5;
}


.user-icon {

    width: 34px;

    height: 34px;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
        linear-gradient(
            145deg,
            #155e8b,
            #061b30
        );

    border:
        1px solid
        rgba(56,189,248,.4);
}


/* =========================================================
   CONTENT
========================================================= */

.content {

    padding: 27px;

    max-width: 1700px;

    margin: auto;
}


.hero {

    display: flex;

    justify-content: space-between;

    align-items: end;

    margin-bottom: 22px;
}


.hero h1 {

    margin: 0;

    font-size: 27px;

    letter-spacing: -.5px;
}


.hero p {

    color: var(--muted);

    font-size: 11px;

    margin-top: 7px;
}


.hero-tag {

    color: var(--cyan);

    font-size: 10px;

    letter-spacing: 1px;
}


/* =========================================================
   GLASS CARDS
========================================================= */

.card {

    background:
        linear-gradient(
            145deg,
            rgba(10,30,50,.88),
            rgba(3,13,25,.91)
        );

    border:
        1px solid
        rgba(56,189,248,.20);

    border-radius: 15px;

    box-shadow:

        0 15px 35px
        rgba(0,0,0,.32),

        inset 0 1px
        rgba(255,255,255,.035),

        0 0 25px
        rgba(0,130,255,.025);

    backdrop-filter:
        blur(14px);

    transform:
        perspective(1200px)
        translateZ(0);

    transition: .25s;
}


.card:hover {

    transform:
        perspective(1200px)
        translateY(-2px)
        rotateX(.4deg);

    border-color:
        rgba(56,189,248,.4);

    box-shadow:

        0 20px 45px
        rgba(0,0,0,.42),

        0 0 28px
        rgba(56,189,248,.08);
}


/* =========================================================
   KPI
========================================================= */

.stats {

    display: grid;

    grid-template-columns:
        repeat(4,1fr);

    gap: 15px;

    margin-bottom: 17px;
}


.stat {

    min-height: 125px;

    padding: 18px;

    position: relative;

    overflow: hidden;
}


.stat::after {

    content: "";

    position: absolute;

    width: 100px;

    height: 100px;

    right: -35px;

    bottom: -45px;

    border-radius: 50%;

    background:
        rgba(56,189,248,.08);

    box-shadow:
        0 0 40px
        rgba(56,189,248,.08);
}


.stat-icon {

    font-size: 24px;

    margin-bottom: 9px;
}


.stat-title {

    color: var(--muted);

    font-size: 9px;

    text-transform: uppercase;

    letter-spacing: 1.3px;
}


.stat-value {

    font-size: 30px;

    font-weight: 900;

    margin-top: 7px;
}


.stat-foot {

    margin-top: 5px;

    color: #597085;

    font-size: 9px;
}


.cyan {
    color: var(--cyan);
}

.green {
    color: #4ade80;
}

.orange {
    color: var(--orange);
}

.red {
    color: #ff5f5f;
}


/* =========================================================
   SECTION GRID
========================================================= */

.two {

    display: grid;

    grid-template-columns:
        1.35fr 1fr;

    gap: 17px;

    margin-bottom: 17px;
}


.three {

    display: grid;

    grid-template-columns:
        1.05fr 1fr 1fr;

    gap: 17px;

    margin-bottom: 17px;
}


.panel {

    padding: 19px;
}


.panel-head {

    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 16px;
}


.panel-title {

    font-size: 14px;

    font-weight: 800;
}


.panel-sub {

    color: var(--muted);

    font-size: 9px;

    margin-top: 4px;
}


.live-tag {

    padding: 5px 9px;

    border-radius: 20px;

    color: #4ade80;

    border:
        1px solid
        rgba(34,197,94,.25);

    background:
        rgba(34,197,94,.05);

    font-size: 8px;

    font-weight: bold;
}


/* =========================================================
   3D THREAT ACTIVITY
========================================================= */

.activity {

    height: 245px;

    border-radius: 12px;

    position: relative;

    overflow: hidden;

    background:

        radial-gradient(
            circle at 50% 55%,
            rgba(0,150,255,.18),
            transparent 38%
        ),

        #030b15;

    border:
        1px solid
        rgba(56,189,248,.12);

    perspective: 700px;
}


.activity-grid {

    position: absolute;

    inset: -30%;

    background-image:

        linear-gradient(
            rgba(56,189,248,.05) 1px,
            transparent 1px
        ),

        linear-gradient(
            90deg,
            rgba(56,189,248,.05) 1px,
            transparent 1px
        );

    background-size: 30px 30px;

    transform:
        perspective(350px)
        rotateX(62deg)
        translateY(40px)
        scale(1.3);

    opacity: .8;
}


.orb {

    position: absolute;

    width: 12px;

    height: 12px;

    border-radius: 50%;

    background: var(--cyan);

    box-shadow:
        0 0 10px var(--cyan),
        0 0 28px var(--cyan);

    animation:
        float 2.5s infinite;
}


.orb.red-orb {

    background: var(--red);

    box-shadow:
        0 0 12px var(--red),
        0 0 30px var(--red);
}


.orb.orange-orb {

    background: var(--orange);

    box-shadow:
        0 0 12px var(--orange),
        0 0 30px var(--orange);
}


.orb1 {
    left: 15%;
    top: 52%;
}

.orb2 {
    left: 38%;
    top: 32%;
}

.orb3 {
    left: 57%;
    top: 60%;
}

.orb4 {
    left: 78%;
    top: 28%;
}

.orb5 {
    left: 72%;
    top: 76%;
}


@keyframes float {

    0%,100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.6);
    }
}


.connection {

    position: absolute;

    height: 1px;

    transform-origin: left;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(56,189,248,.7),
            transparent
        );
}


.connection1 {

    width: 210px;

    left: 16%;

    top: 52%;

    transform:
        rotate(-21deg);
}


.connection2 {

    width: 250px;

    left: 38%;

    top: 34%;

    transform:
        rotate(20deg);
}


.connection3 {

    width: 190px;

    left: 58%;

    top: 60%;

    transform:
        rotate(-30deg);
}


.activity-label {

    position: absolute;

    left: 15px;

    bottom: 13px;

    color: #668097;

    font-size: 8px;

    letter-spacing: 1px;
}


/* =========================================================
   DISTRIBUTION
========================================================= */

.distribution {

    padding-top: 5px;
}


.dist {

    margin: 18px 0;
}


.dist-top {

    display: flex;

    justify-content: space-between;

    margin-bottom: 7px;

    font-size: 10px;
}


.dist-name {
    color: #a9bacb;
}


.dist-value {
    font-weight: bold;
}


.bar {

    height: 7px;

    border-radius: 20px;

    background: #0d2033;

    overflow: hidden;
}


.fill {

    height: 100%;

    border-radius: 20px;

    transition: width .6s;
}


.fill-red {
    background: linear-gradient(
        90deg,
        #991b1b,
        #ff5252
    );
}


.fill-orange {
    background: linear-gradient(
        90deg,
        #9a3412,
        #fb923c
    );
}


.fill-yellow {
    background: linear-gradient(
        90deg,
        #a16207,
        #fde047
    );
}


.fill-green {
    background: linear-gradient(
        90deg,
        #166534,
        #4ade80
    );
}


/* =========================================================
   AI ANALYSIS
========================================================= */

.analysis {

    background:
        rgba(2,11,21,.55);

    border:
        1px solid
        rgba(56,189,248,.12);

    border-radius: 11px;

    padding: 15px;
}


.threat-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 13px;
}


.threat-name {

    font-size: 20px;

    font-weight: 900;
}


.risk {

    padding: 6px 12px;

    border-radius: 20px;

    font-size: 9px;

    font-weight: 900;

    color: #ff8585;

    border:
        1px solid
        rgba(239,68,68,.4);

    background:
        rgba(239,68,68,.08);
}


.metric {

    display: flex;

    justify-content: space-between;

    padding: 9px 0;

    border-bottom:
        1px solid
        rgba(56,189,248,.07);

    font-size: 10px;
}


.metric span:first-child {

    color: var(--muted);
}


.metric span:last-child {

    font-weight: 700;
}


.explain {

    margin-top: 13px;

    padding: 11px;

    border-left:
        3px solid
        var(--cyan);

    background:
        rgba(56,189,248,.045);

    color: #adc0d0;

    font-size: 10px;

    line-height: 1.55;
}


.recommend {

    margin-top: 9px;

    padding: 11px;

    border-left:
        3px solid
        var(--green);

    background:
        rgba(34,197,94,.045);

    color: #a9c9b2;

    font-size: 10px;

    line-height: 1.55;
}


/* =========================================================
   SIMULATOR
========================================================= */

.sim-buttons {

    display: grid;

    grid-template-columns:
        repeat(2,1fr);

    gap: 10px;

    margin-top: 18px;
}


.sim {

    padding: 17px 10px;

    border-radius: 10px;

    background:
        rgba(255,255,255,.025);

    border: 1px solid;

    color: white;

    cursor: pointer;

    font-size: 10px;

    font-weight: 900;

    transition: .2s;
}


.sim:hover {

    transform:
        translateY(-3px)
        scale(1.015);

    box-shadow:
        0 8px 20px
        rgba(0,0,0,.3);
}


.normal {
    border-color: #166534;
    color: #5ee890;
}

.suspicious {
    border-color: #854d0e;
    color: #fde047;
}

.scan {
    border-color: #9a3412;
    color: #fb923c;
}

.brute {
    border-color: #991b1b;
    color: #ff6b6b;
}


/* =========================================================
   PIPELINE
========================================================= */

.pipeline {

    margin-top: 17px;

    padding: 13px;

    border-radius: 9px;

    background:
        #030b15;

    border:
        1px solid
        rgba(56,189,248,.10);
}


.pipeline-title {

    color: var(--cyan);

    font-size: 9px;

    font-weight: bold;

    margin-bottom: 10px;
}


.pipeline-step {

    color: #6f8499;

    font-size: 9px;

    padding: 3px 0;
}


.pipeline-step span {

    color: var(--cyan);

    margin-right: 7px;
}


/* =========================================================
   EVENT TABLE
========================================================= */

.table-wrap {

    overflow-x: auto;
}


table {

    width: 100%;

    border-collapse: collapse;

    font-size: 10px;
}


th {

    padding: 11px;

    text-align: left;

    color: #5e748a;

    font-size: 8px;

    text-transform: uppercase;

    letter-spacing: 1px;

    border-bottom:
        1px solid
        rgba(56,189,248,.13);
}


td {

    padding: 12px 11px;

    color: #aabccc;

    border-bottom:
        1px solid
        rgba(56,189,248,.055);
}


tr:hover td {

    background:
        rgba(56,189,248,.035);
}


.badge {

    display: inline-block;

    padding: 4px 8px;

    border-radius: 20px;

    font-size: 8px;

    font-weight: 900;
}


.LOW {

    color: #86efac;

    background:
        rgba(34,197,94,.10);
}


.MEDIUM {

    color: #fde68a;

    background:
        rgba(250,204,21,.10);
}


.HIGH {

    color: #fdba74;

    background:
        rgba(251,146,60,.12);
}


.CRITICAL {

    color: #fca5a5;

    background:
        rgba(239,68,68,.13);
}


/* =========================================================
   FOOTER
========================================================= */

.footer {

    text-align: center;

    padding: 20px;

    color: #40576d;

    font-size: 8px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1200px) {

    .stats {
        grid-template-columns:
            repeat(2,1fr);
    }

    .three {
        grid-template-columns: 1fr;
    }
}


@media(max-width:900px) {

    .sidebar {
        width: 70px;
    }

    .brand-name,
    .brand-sub,
    .nav-item span {
        display: none;
    }

    .main {
        margin-left: 70px;
    }

    .two {
        grid-template-columns: 1fr;
    }

    .search {
        display: none;
    }
}


@media(max-width:600px) {

    .stats {
        grid-template-columns: 1fr;
    }

    .content {
        padding: 15px;
    }

    .hero {
        display: block;
    }

}


/* Data-driven Communication Event Activity visuals */
.gauge-arc {
    background: conic-gradient(var(--gauge-color, #27eaff) calc(var(--gauge-value, 0%) * 1), rgba(35,57,83,.72) 0);
}
.gauge-arc span { color: #eaf8ff; }
.channel-flow {
    display:flex; align-items:center; justify-content:space-around;
    gap:8px; padding:10px 8px; min-height:145px;
    background:
      radial-gradient(circle at 50% 50%, rgba(39,234,255,.10), transparent 48%),
      linear-gradient(rgba(56,189,248,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(56,189,248,.035) 1px, transparent 1px),
      rgba(2,11,21,.35);
    background-size:auto,24px 24px,24px 24px,auto;
    border:1px solid rgba(56,189,248,.12); border-radius:10px;
}
.channel-node {
    width:29%; min-width:78px; min-height:100px; border-radius:12px;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:4px; background:rgba(8,30,56,.82); border:1px solid rgba(39,234,255,.45);
    box-shadow:0 0 18px rgba(39,234,255,.10), inset 0 0 16px rgba(39,234,255,.06);
}
.sms-node { border-color:rgba(255,98,200,.45); box-shadow:0 0 18px rgba(255,98,200,.10), inset 0 0 16px rgba(255,98,200,.06); }
.channel-node-icon { font-size:19px; color:#58eaff; }
.sms-node .channel-node-icon { color:#ff72d0; }
.channel-node-name { font-size:9px; font-weight:800; letter-spacing:1px; color:#cceeff; }
.channel-node strong { font-size:22px; color:#fff; }
.channel-node small { font-size:7px; color:#7890a8; letter-spacing:.8px; }
.channel-connector { flex:1; min-width:48px; display:flex; flex-direction:column; align-items:center; gap:7px; color:#8aa5bd; font-size:7px; text-align:center; letter-spacing:.5px; }
.channel-connector i { width:100%; height:2px; background:linear-gradient(90deg,#27eaff,#b65cff,#ff62c8); box-shadow:0 0 9px rgba(39,234,255,.45); position:relative; }
.channel-connector i:after { content:""; position:absolute; right:0; top:-3px; border:4px solid transparent; border-left-color:#ff62c8; }
.signal-bars b, .intensity-bars b { transition:height .35s ease; }

</style>


<style>
/* ===== VAPP FUNCTIONAL MODULES ===== */
.module-panel{margin-top:17px;padding:19px}
.module-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.module-stat{padding:15px;border:1px solid rgba(56,189,248,.15);border-radius:11px;background:rgba(2,11,21,.55)}
.module-stat small{display:block;color:#7890a8;font-size:9px;text-transform:uppercase;letter-spacing:1px}
.module-stat strong{display:block;margin-top:7px;font-size:23px;color:#38bdf8}
.nav-item{cursor:pointer;text-decoration:none}
.nav-item.active{color:white}
.nav-item:visited{color:#8198ad}
.search-form{display:flex;align-items:center;width:300px}
.search-form input{width:100%;padding:11px 15px;border-radius:25px;background:rgba(8,26,44,.75);border:1px solid rgba(56,189,248,.2);color:#e8f7ff;font-size:11px;outline:none}
.search-form button{margin-left:-42px;border:0;background:transparent;color:#38bdf8;cursor:pointer}
.event-filter{width:100%;padding:10px 12px;border-radius:9px;background:#061425;border:1px solid rgba(56,189,248,.15);color:#e8f7ff;margin-bottom:12px}
.module-list{max-height:320px;overflow:auto}
.incident{padding:13px;margin:9px 0;border-radius:10px;background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.18)}
.incident strong{color:#ff8585}
.report-btn{display:inline-block;text-decoration:none;padding:10px 14px;border-radius:9px;background:#087fc4;color:white;font-size:10px;font-weight:800}
.setting-row{display:flex;justify-content:space-between;align-items:center;padding:13px 0;border-bottom:1px solid rgba(56,189,248,.08);font-size:11px}
.setting-row:last-child{border-bottom:0}
.status-online{color:#4ade80;font-weight:800}
.email-security-panel{margin-top:17px;padding:19px;border-radius:15px;background:linear-gradient(145deg,rgba(10,30,50,.92),rgba(3,13,25,.96));border:1px solid rgba(56,189,248,.22);box-shadow:0 15px 35px rgba(0,0,0,.3)}
.email-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:15px}
.email-field{display:flex;flex-direction:column;gap:6px}.email-field.full{grid-column:1/-1}
.email-field label{color:#7890a8;font-size:9px;text-transform:uppercase;letter-spacing:1px}
.email-field input,.email-field textarea{width:100%;box-sizing:border-box;padding:11px;border-radius:9px;background:#04101e;border:1px solid rgba(56,189,248,.18);color:#e8f7ff;outline:none;font-family:inherit;font-size:11px}
.email-field textarea{min-height:105px;resize:vertical}
.email-analyze-btn{margin-top:14px;padding:12px 16px;border:0;border-radius:9px;background:linear-gradient(135deg,#00bcd4,#087cff);color:white;font-weight:900;font-size:10px;cursor:pointer}
.email-error{display:none;margin-top:12px;padding:10px;border-radius:9px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#ff8585;font-size:10px}
.email-result{display:none;margin-top:15px;padding:15px;border-radius:11px;background:rgba(100,5,20,.12);border:1px solid rgba(239,68,68,.3)}
.email-result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:12px}
.email-result-card{padding:11px;border-radius:9px;background:rgba(2,11,21,.65)}
.email-result-card span{display:block;color:#647b91;font-size:8px;text-transform:uppercase}.email-result-card strong{display:block;margin-top:5px;color:white;font-size:11px}
.email-result-text{margin-top:9px;padding:10px;border-radius:8px;background:rgba(2,11,21,.65);color:#b8cad9;font-size:10px;line-height:1.5}
.email-result-text strong{color:#9fdfff}
.email-saved{margin-top:11px;color:#4ade80;font-size:10px;font-weight:700}
.email-alert-header{display:flex;justify-content:space-between;align-items:center}.email-alert-title{color:#ff6666;font-size:14px;font-weight:900}.email-risk-badge{padding:5px 9px;border-radius:15px;color:#ffb0b0;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.35);font-size:8px;font-weight:900}
@media(max-width:900px){.email-grid,.email-result-grid{grid-template-columns:1fr}.email-field.full{grid-column:auto}.module-grid{grid-template-columns:1fr 1fr}}

/* ===== SMS CSV IMPORT ===== */
.sms-import-panel{margin-top:17px;padding:19px;border-radius:15px;background:linear-gradient(145deg,rgba(10,30,50,.92),rgba(3,13,25,.96));border:1px solid rgba(56,189,248,.22);box-shadow:0 15px 35px rgba(0,0,0,.3)}
.sms-upload-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:15px}
.sms-upload-row input[type=file]{flex:1;min-width:220px;padding:11px;border-radius:9px;background:#04101e;border:1px solid rgba(56,189,248,.18);color:#b8cad9;font-size:11px}
.sms-import-btn{padding:12px 16px;border:0;border-radius:9px;background:linear-gradient(135deg,#00bcd4,#087cff);color:white;font-weight:900;font-size:10px;cursor:pointer}
.sms-import-btn:disabled{opacity:.6;cursor:wait}
.sms-help{margin-top:10px;color:#7890a8;font-size:10px;line-height:1.6}
.sms-status{display:none;margin-top:13px;padding:11px;border-radius:9px;font-size:10px;line-height:1.5}
.sms-status.success{display:block;color:#86efac;background:rgba(34,197,94,.07);border:1px solid rgba(34,197,94,.25)}
.sms-status.error{display:block;color:#ff9999;background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.3)}
.sms-results{display:none;margin-top:15px}
.sms-results table{min-width:650px}
@media(max-width:700px){.sms-upload-row{align-items:stretch;flex-direction:column}.sms-upload-row input[type=file]{min-width:0;width:100%}}
</style>


<style id="vapp-reference-redesign">
:root{--bg:#02091c;--panel:#071735;--cyan:#28c9ff;--blue:#168bff;--purple:#9b35ff;--green:#16e0a0;--text:#edf5ff;--muted:#9ab1d2}
html{scroll-behavior:smooth;scroll-padding-top:92px}
body{background:radial-gradient(ellipse at 8% 5%,rgba(0,101,255,.22),transparent 32%),radial-gradient(ellipse at 95% 28%,rgba(82,36,255,.15),transparent 30%),#02091c;color:#edf5ff}
body::before{opacity:.16;background-size:54px 54px}
.sidebar{width:252px;padding:24px 14px 22px;background:linear-gradient(180deg,#03112d 0%,#020a1d 62%,#030b20 100%);border-right:1px solid rgba(45,145,255,.42);box-shadow:12px 0 42px rgba(0,18,66,.38)}
.brand{padding-bottom:24px;margin-bottom:21px;border-bottom:1px solid rgba(48,130,255,.28)}
.shield-logo{width:116px;height:116px;border:0;border-radius:0;background:radial-gradient(circle,rgba(0,143,255,.35),rgba(0,53,125,.12) 60%,transparent 72%);font-size:76px;filter:drop-shadow(0 0 16px #087fff);box-shadow:none;transform:none;position:relative}
.shield-logo::before{content:"";position:absolute;inset:8px;border:1px solid rgba(34,174,255,.65);border-radius:50%;box-shadow:0 0 18px #087fff,inset 0 0 20px rgba(0,130,255,.25);transform:rotate(-20deg) scaleX(1.2)}
.brand-name{margin-top:3px;font-size:34px;letter-spacing:4px;background:linear-gradient(90deg,#35e4ff,#a34bff);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 24px rgba(34,173,255,.4)}
.brand-sub{max-width:190px;margin:5px auto 0;font-size:11px;line-height:1.45;letter-spacing:.7px;color:#a9c5ed}
.nav{gap:8px}
.nav-item{min-height:55px;padding:12px 15px;border:1px solid transparent;border-left:3px solid transparent;border-radius:15px;gap:14px;color:#b6c9e6;font-size:14px;transition:all .22s ease}
.nav-item:hover{background:linear-gradient(100deg,rgba(0,139,255,.17),rgba(87,42,255,.08));border-color:rgba(35,155,255,.22);color:#fff;transform:translateX(2px)}
.nav-item.active{border:1px solid rgba(40,197,255,.82);border-left:3px solid #36e0ff;background:linear-gradient(105deg,rgba(0,174,255,.36),rgba(43,61,194,.32));box-shadow:0 0 16px rgba(0,145,255,.45),inset 0 0 18px rgba(30,163,255,.14);color:white}
.nav-icon{width:27px;font-size:22px;filter:drop-shadow(0 0 5px rgba(45,177,255,.3))}
.main{margin-left:252px;min-height:100vh}
.topbar{height:82px;padding:0 28px;background:rgba(2,9,28,.84);border-bottom:1px solid rgba(40,126,255,.25);backdrop-filter:blur(20px)}
.search-form{width:min(500px,46vw)}
.search-form input{height:48px;padding:0 20px;border-radius:28px;background:linear-gradient(110deg,rgba(10,27,70,.94),rgba(5,20,49,.94));border:1px solid rgba(54,116,255,.62);box-shadow:inset 0 0 15px rgba(38,102,255,.09),0 0 15px rgba(0,82,255,.08);font-size:14px}
.search-form input::placeholder{color:#a9bad7}
.search-form button{font-size:19px;margin-left:-39px}
.top-right{gap:22px}
.system{padding:11px 17px;border-radius:24px;background:rgba(0,204,145,.08);border-color:rgba(0,222,159,.34);color:#20f0b0;font-size:13px;box-shadow:0 0 18px rgba(0,220,150,.08)}
.system-dot{width:11px;height:11px}
.user{font-size:14px;gap:11px;color:#e1ebff}
.user-icon{width:44px;height:44px;font-size:20px;background:linear-gradient(145deg,#227bff,#2716a5);border:1px solid #347eff;box-shadow:0 0 18px rgba(29,102,255,.25)}
.content{max-width:1900px;padding:14px 22px 28px}
.hero.vapp-hero{height:188px;display:flex;align-items:center;justify-content:flex-start;gap:26px;position:relative;overflow:hidden;margin:0 0 21px;padding:20px 27px;border:1px solid rgba(75,102,255,.82);border-radius:24px;background:radial-gradient(ellipse at 4% 50%,rgba(86,35,255,.48),transparent 30%),radial-gradient(ellipse at 88% 50%,rgba(0,111,255,.34),transparent 36%),linear-gradient(100deg,#101b77 0%,#061c50 45%,#080c39 100%);box-shadow:inset 0 0 35px rgba(45,80,255,.24),0 12px 35px rgba(0,0,0,.24)}
.vapp-hero::before{content:"";position:absolute;inset:0;background-image:radial-gradient(circle,rgba(44,150,255,.6) 1px,transparent 1.5px);background-size:13px 13px;mask-image:linear-gradient(90deg,transparent 38%,#000 70%,transparent);opacity:.18;pointer-events:none}
.hero-shield{width:150px;height:150px;flex:0 0 150px;display:grid;place-items:center;position:relative;border:1px solid rgba(39,202,255,.58);border-radius:50%;background:radial-gradient(circle,rgba(0,194,255,.24),rgba(0,50,180,.1) 56%,transparent 70%);box-shadow:0 0 28px rgba(0,162,255,.35),inset 0 0 28px rgba(0,146,255,.18)}
.hero-shield::before{content:"🛡️";font-size:88px;filter:drop-shadow(0 0 14px #00baff)}
.hero-shield span{position:absolute;z-index:1;top:47px;left:57px;width:39px;height:39px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(145deg,#13f3b1,#00a87d);color:white;font-size:30px;font-weight:900;box-shadow:0 0 18px #00f0ac}
.hero-copy{position:relative;z-index:2;min-width:380px}
.hero-copy h1{margin:0;font-size:clamp(23px,2.1vw,36px);font-weight:850;letter-spacing:-.6px;color:#f3f7ff;text-shadow:0 3px 20px rgba(80,153,255,.2)}
.hero-copy p{margin:12px 0 0;color:#d0e1ff;font-size:15px;line-height:1.5}
.hero-tag{display:none}
.hero-visual{position:absolute;right:12px;top:0;width:47%;height:100%;overflow:hidden}
.hero-world{position:absolute;inset:0;background:radial-gradient(ellipse at 45% 46%,rgba(0,133,255,.19),transparent 58%);opacity:.8}
.hero-orbit{position:absolute;width:340px;height:100px;right:74px;bottom:9px;border:2px solid rgba(0,170,255,.85);border-radius:50%;transform:rotate(-5deg);box-shadow:0 0 18px #007bff,inset 0 0 15px rgba(0,137,255,.4)}
.orbit-b{width:410px;height:125px;right:40px;bottom:1px;border-color:rgba(116,57,255,.68);transform:rotate(8deg)}
.hero-envelope{position:absolute;right:60%;top:24px;font-size:48px;color:#9bdfff;transform:rotate(-12deg);filter:drop-shadow(0 0 12px #248bff)}
.hero-qr{position:absolute;right:9%;top:38px;font-size:48px;color:#c6e5ff;text-shadow:0 0 12px #168cff}
.hero-laptop{position:absolute;right:19%;bottom:17px;width:210px;height:112px;transform:perspective(500px) rotateY(-12deg) rotateX(4deg);filter:drop-shadow(0 0 15px rgba(0,111,255,.7))}
.laptop-screen{height:91px;border:5px solid #7aaaff;border-bottom:8px solid #173b92;border-radius:9px 9px 4px 4px;background:radial-gradient(circle at 50% 50%,#103d9b,#020d31 72%);display:grid;place-items:center;box-shadow:inset 0 0 20px #087cff}
.laptop-screen span{font-size:54px;filter:drop-shadow(0 0 12px #14aaff)}
.laptop-base{height:12px;margin:0 -16px;background:linear-gradient(90deg,#1d3984,#a5c5ff,#243d91);clip-path:polygon(7% 0,93% 0,100% 100%,0 100%);border-radius:0 0 8px 8px}
.hero-phone{position:absolute;right:2%;bottom:25px;width:35px;height:67px;border:2px solid #8bb8ff;border-radius:8px;background:linear-gradient(160deg,#1844a5,#061337);display:grid;place-items:center;color:#64ddff;box-shadow:0 0 15px #147dff;transform:rotate(10deg)}
.stats{grid-template-columns:repeat(4,minmax(0,1fr));gap:19px;margin-bottom:25px}
.stat{min-height:178px;padding:22px 23px;border-radius:21px;position:relative;isolation:isolate;border:1px solid transparent;box-shadow:inset 0 0 25px rgba(255,255,255,.055),0 12px 30px rgba(0,0,0,.24)}
.stat:nth-child(1){background:radial-gradient(ellipse at 88% 100%,rgba(0,168,255,.34),transparent 50%),linear-gradient(130deg,rgba(0,111,220,.92),rgba(5,23,79,.97));border-color:#058bff}
.stat:nth-child(2){background:radial-gradient(ellipse at 88% 100%,rgba(220,35,255,.32),transparent 50%),linear-gradient(130deg,rgba(112,15,174,.92),rgba(38,9,91,.98));border-color:#bd32ff}
.stat:nth-child(3){background:radial-gradient(ellipse at 88% 100%,rgba(255,166,43,.34),transparent 50%),linear-gradient(130deg,rgba(126,77,23,.95),rgba(59,36,24,.98));border-color:#ffb338}
.stat:nth-child(4){background:radial-gradient(ellipse at 88% 100%,rgba(0,255,177,.32),transparent 50%),linear-gradient(130deg,rgba(0,105,100,.94),rgba(0,48,65,.98));border-color:#00d7a0}
.stat::after{width:150px;height:80px;right:-7px;bottom:-15px;border-radius:50%;background:transparent;box-shadow:none;border-top:2px solid rgba(56,222,255,.65);transform:rotate(-18deg);opacity:.7}
.stat-icon{font-size:34px;margin-bottom:9px;filter:drop-shadow(0 0 9px rgba(93,208,255,.45))}
.stat-title{font-size:13px;color:#d2e2ff;letter-spacing:.3px}
.stat-value{font-size:44px;margin-top:8px;line-height:1.05;text-shadow:0 0 18px currentColor}
.stat-foot{font-size:12px;color:#d0ddf2;margin-top:8px}
.stat:nth-child(1) .stat-value{color:#39e6ff}.stat:nth-child(2) .stat-value{color:#ff74df}.stat:nth-child(3) .stat-value{color:#ffe0a0}.stat:nth-child(4) .stat-value{color:#42f6ba}
.two{grid-template-columns:1.35fr 1fr;gap:20px;margin-bottom:22px}
.card{border-radius:21px;border:1px solid rgba(45,120,255,.48);background:linear-gradient(145deg,rgba(9,29,72,.96),rgba(4,13,43,.98));box-shadow:inset 0 0 28px rgba(30,92,255,.09),0 16px 36px rgba(0,0,0,.27);backdrop-filter:blur(16px)}
.card:hover{transform:translateY(-2px);border-color:rgba(49,169,255,.78);box-shadow:0 18px 42px rgba(0,0,0,.35),0 0 24px rgba(35,116,255,.14)}
.panel{padding:22px}
.panel-head{margin-bottom:17px}
.panel-title{font-size:20px;font-weight:850;color:#f2f6ff}
.panel-sub{font-size:12px;color:#a7bbdc;margin-top:5px}
.live-tag{padding:8px 13px;border-radius:22px;font-size:11px;color:#29f4b6;background:rgba(0,225,160,.08);border-color:rgba(0,232,166,.38);box-shadow:0 0 13px rgba(0,222,158,.1)}
.activity{height:300px;border-radius:17px;background:#020b24;border-color:rgba(35,136,255,.2)}
.vapp-map{height:300px;background:radial-gradient(ellipse at 50% 50%,rgba(0,93,255,.2),transparent 62%),linear-gradient(180deg,#020d2c,#02091c);}
.map-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(34,132,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(34,132,255,.08) 1px,transparent 1px);background-size:35px 35px;opacity:.25;mask-image:linear-gradient(transparent,#000 18%,#000 90%,transparent)}
.world-map{position:absolute;inset:2% 2% 8%;width:96%;height:88%;filter:drop-shadow(0 0 10px rgba(0,115,255,.35))}
.map-scanline{position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(0,165,255,.12) 50%,transparent 55%);background-size:100% 90px;animation:mapScan 6s linear infinite;pointer-events:none}
@keyframes mapScan{from{background-position:0 -90px}to{background-position:0 300px}}
.map-legend{position:absolute;left:0;right:0;bottom:0;height:43px;display:flex;align-items:center;gap:24px;padding:0 18px;background:linear-gradient(90deg,rgba(6,13,43,.92),rgba(4,13,39,.75));border-top:1px solid rgba(47,119,255,.25);color:#d9e7ff;font-size:12px}
.map-legend span{display:flex;align-items:center;gap:8px}.map-legend i,.donut-label i{width:12px;height:12px;border-radius:50%;display:inline-block}.legend-red{background:#ff405d;box-shadow:0 0 10px #ff405d}.legend-orange{background:#ff9b22;box-shadow:0 0 10px #ff9b22}.legend-blue{background:#159fff;box-shadow:0 0 10px #159fff}
.distribution{padding-top:0}
.donut-layout{min-height:255px;display:grid;grid-template-columns:minmax(170px,.9fr) minmax(180px,1.1fr);align-items:center;gap:17px;position:relative}
.donut-wrap{display:grid;place-items:center;min-height:220px}
.threat-donut{width:min(210px,19vw);min-width:165px;aspect-ratio:1;border-radius:50%;position:relative;background:conic-gradient(#327cff 0 25%,#ff9a22 25% 50%,#963cff 50% 75%,#20dda4 75% 100%);box-shadow:0 0 25px rgba(44,109,255,.25),inset 0 0 12px rgba(255,255,255,.15)}
.threat-donut::before{content:"";position:absolute;inset:19%;border-radius:50%;background:radial-gradient(circle at 50% 35%,#102b69,#06132f 70%);box-shadow:inset 0 0 22px rgba(0,0,0,.65)}
.donut-center{position:absolute;inset:19%;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;text-align:center}.donut-center span{font-size:42px;filter:drop-shadow(0 0 10px #168fff)}.donut-center small{font-size:9px;letter-spacing:1px;color:#9bc8ff;font-weight:800}
.donut-legend{display:flex;flex-direction:column;gap:0;border-top:1px solid rgba(53,123,255,.16);border-bottom:1px solid rgba(53,123,255,.16)}
.donut-item{min-height:53px;display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:12px;border-bottom:1px solid rgba(53,123,255,.13);font-size:13px}.donut-item:last-child{border-bottom:0}.donut-label{display:flex;align-items:center;gap:10px;color:#e0eaff;white-space:nowrap}.donut-item strong{font-size:14px;color:#f4f7ff}.donut-item small{min-width:34px;text-align:right;color:#a9c0e7;font-size:11px}
.dot-blue{background:#168fff;box-shadow:0 0 9px #168fff}.dot-orange{background:#ff941d;box-shadow:0 0 9px #ff941d}.dot-purple{background:#a13aff;box-shadow:0 0 9px #a13aff}.dot-green{background:#17dfa4;box-shadow:0 0 9px #17dfa4}.legacy-bars{display:none}
.three{gap:20px}
.module-panel,.email-security-panel,.sms-import-panel{border-radius:20px;border-color:rgba(45,120,255,.4);background:linear-gradient(145deg,rgba(9,29,72,.96),rgba(4,13,43,.98));box-shadow:inset 0 0 24px rgba(30,92,255,.07),0 15px 35px rgba(0,0,0,.25)}
.module-stat{border-color:rgba(57,148,255,.28);background:linear-gradient(145deg,rgba(8,37,85,.75),rgba(3,17,48,.8));border-radius:13px}.module-stat small{font-size:10px;color:#9ab8e5}.module-stat strong{color:#39d7ff}
.analysis,.pipeline,.email-field input,.email-field textarea,.email-result-card,.email-result-text{background:rgba(2,12,36,.7);border-color:rgba(54,135,255,.2)}
.explain,.recommend{border-radius:8px}
.sim{border-radius:12px;font-size:11px;background:rgba(13,39,82,.72)}
th{color:#8da9d2;font-size:9px}td{font-size:11px;color:#d0ddf2}tr:hover td{background:rgba(37,122,255,.1)}
.event-filter{background:#061634;border-color:rgba(55,134,255,.35);color:#eaf2ff}
.report-btn,.email-analyze-btn,.sms-import-btn{background:linear-gradient(115deg,#00b9df,#176dff 65%,#783dff);box-shadow:0 7px 18px rgba(0,111,255,.22);border-radius:10px}
.footer{color:#7189b2;font-size:10px}
@media(max-width:1250px){.sidebar{width:220px}.main{margin-left:220px}.stats{gap:12px}.stat{padding:18px}.stat-value{font-size:36px}.hero-visual{width:42%}.hero-copy{min-width:320px}}
@media(max-width:1000px){.sidebar{width:76px;padding:20px 9px}.brand-sub,.brand-name,.nav-item span{display:none}.brand{padding-bottom:18px}.shield-logo{width:54px;height:65px;font-size:42px}.main{margin-left:76px}.nav-item{justify-content:center;padding:12px 5px}.nav-icon{font-size:22px}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-visual{opacity:.55;width:48%}.hero-copy{min-width:0}.two{grid-template-columns:1fr}.donut-layout{grid-template-columns:minmax(150px,.8fr) 1.2fr}}
@media(max-width:650px){.topbar{padding:0 13px}.search-form{width:55vw}.top-right{gap:8px}.system{font-size:0;padding:10px}.system-dot{width:11px;height:11px}.user{font-size:0}.user-icon{width:38px;height:38px}.content{padding:12px}.hero.vapp-hero{height:165px;padding:17px;gap:12px}.hero-shield{width:76px;height:76px;flex-basis:76px}.hero-shield::before{font-size:52px}.hero-shield span{top:25px;left:28px;width:25px;height:25px;font-size:19px}.hero-copy h1{font-size:20px}.hero-copy p{font-size:11px}.hero-visual{opacity:.25;width:40%}.stats{grid-template-columns:1fr 1fr;gap:10px}.stat{min-height:145px;padding:14px}.stat-value{font-size:31px}.stat-title{font-size:10px}.stat-foot{font-size:10px}.panel{padding:14px}.panel-title{font-size:16px}.activity,.vapp-map{height:230px}.map-legend{gap:10px;padding:0 8px;font-size:9px}.map-legend i{width:8px;height:8px}.donut-layout{grid-template-columns:1fr;gap:8px}.donut-wrap{min-height:175px}.threat-donut{width:165px}.donut-item{min-height:43px}.module-grid{grid-template-columns:1fr 1fr}.three{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>


<style id="vapp-radiant-upgrade">
/* Radiant colour treatment: preserve all application data and behaviour */
:root{
  --aqua:#37f4ff;--electric:#238dff;--violet:#a855ff;
  --pink:#ff58c8;--mint:#31ffc0;--gold:#ffc45c;
}
body{
  background:
    radial-gradient(ellipse at 12% 16%,rgba(0,190,255,.20),transparent 29%),
    radial-gradient(ellipse at 84% 12%,rgba(151,52,255,.19),transparent 28%),
    radial-gradient(ellipse at 78% 78%,rgba(0,255,190,.08),transparent 25%),
    radial-gradient(ellipse at 34% 92%,rgba(255,54,180,.07),transparent 30%),
    #02091c;
}
.sidebar{
  background:
    radial-gradient(ellipse at 50% 0%,rgba(0,169,255,.18),transparent 45%),
    linear-gradient(180deg,#061735 0%,#030c22 58%,#080d2c 100%);
  border-right-color:rgba(57,207,255,.55);
  box-shadow:12px 0 48px rgba(0,106,255,.16),inset -1px 0 18px rgba(60,120,255,.07);
}
.brand-name{
  background:linear-gradient(90deg,#49f5ff 0%,#55a8ff 42%,#dc75ff 75%,#ff77c9 100%);
  -webkit-background-clip:text;background-clip:text;
  filter:drop-shadow(0 0 12px rgba(74,192,255,.32));
}
.nav-item.active{
  background:linear-gradient(105deg,rgba(0,207,255,.34),rgba(84,67,255,.31) 58%,rgba(196,54,255,.17));
  border-color:rgba(73,222,255,.9);
  box-shadow:0 0 22px rgba(0,185,255,.34),0 0 38px rgba(110,64,255,.13),inset 0 0 22px rgba(50,188,255,.16);
}
.nav-item:hover{box-shadow:0 0 18px rgba(87,121,255,.17)}
.topbar{
  background:linear-gradient(90deg,rgba(3,12,34,.94),rgba(8,13,43,.91),rgba(3,14,35,.94));
  border-bottom-color:rgba(66,173,255,.34);
}
.search-form input{
  border-color:rgba(69,169,255,.75);
  box-shadow:inset 0 0 20px rgba(57,118,255,.12),0 0 22px rgba(24,127,255,.13);
}
.hero.vapp-hero{
  background:
    radial-gradient(ellipse at 4% 52%,rgba(112,45,255,.55),transparent 31%),
    radial-gradient(ellipse at 70% 5%,rgba(0,218,255,.23),transparent 36%),
    radial-gradient(ellipse at 96% 80%,rgba(255,56,190,.22),transparent 33%),
    linear-gradient(105deg,#101b79 0%,#08245c 48%,#130b4a 100%);
  border-color:rgba(93,146,255,.9);
  box-shadow:inset 0 0 42px rgba(57,103,255,.27),0 0 28px rgba(34,126,255,.12),0 12px 35px rgba(0,0,0,.24);
}
.hero-shield{box-shadow:0 0 34px rgba(0,221,255,.48),0 0 68px rgba(89,74,255,.22),inset 0 0 32px rgba(0,146,255,.24)}
.hero-orbit{border-color:rgba(46,225,255,.95);box-shadow:0 0 23px #078bff,inset 0 0 18px rgba(0,205,255,.48)}
.orbit-b{border-color:rgba(196,86,255,.84);box-shadow:0 0 20px rgba(178,58,255,.48)}
.stat{
  box-shadow:inset 0 0 30px rgba(255,255,255,.075),0 12px 32px rgba(0,0,0,.28),0 0 20px rgba(40,135,255,.10);
  transition:transform .24s ease,filter .24s ease,box-shadow .24s ease;
}
.stat:hover{transform:translateY(-4px);filter:saturate(1.2) brightness(1.08);box-shadow:inset 0 0 34px rgba(255,255,255,.10),0 16px 38px rgba(0,0,0,.32),0 0 28px rgba(64,166,255,.20)}
.stat:nth-child(1){background:radial-gradient(ellipse at 90% 8%,rgba(0,237,255,.25),transparent 48%),radial-gradient(ellipse at 95% 100%,rgba(0,133,255,.42),transparent 54%),linear-gradient(135deg,#0756ad,#07194e 76%);border-color:#1bbcff}
.stat:nth-child(2){background:radial-gradient(ellipse at 88% 4%,rgba(255,83,216,.27),transparent 48%),radial-gradient(ellipse at 95% 100%,rgba(180,43,255,.38),transparent 55%),linear-gradient(135deg,#7313a7,#26094e 78%);border-color:#d34bff}
.stat:nth-child(3){background:radial-gradient(ellipse at 90% 5%,rgba(255,212,92,.28),transparent 48%),radial-gradient(ellipse at 95% 100%,rgba(255,130,43,.37),transparent 55%),linear-gradient(135deg,#8c4a20,#3b241e 78%);border-color:#ffc45c}
.stat:nth-child(4){background:radial-gradient(ellipse at 88% 4%,rgba(49,255,192,.27),transparent 48%),radial-gradient(ellipse at 95% 100%,rgba(0,205,156,.4),transparent 55%),linear-gradient(135deg,#087d77,#043543 78%);border-color:#21f0bd}
.card{
  border-color:rgba(75,150,255,.58);
  background:linear-gradient(145deg,rgba(10,31,77,.97),rgba(5,14,47,.98));
  box-shadow:inset 0 0 34px rgba(60,110,255,.12),0 16px 36px rgba(0,0,0,.27),0 0 18px rgba(43,136,255,.07);
}
.card:hover{border-color:rgba(80,205,255,.82);box-shadow:inset 0 0 34px rgba(80,130,255,.15),0 18px 42px rgba(0,0,0,.35),0 0 28px rgba(40,174,255,.16)}
.panel-title{text-shadow:0 0 18px rgba(84,176,255,.23)}
.live-tag{border-color:rgba(35,255,192,.52);box-shadow:0 0 18px rgba(0,255,180,.17),inset 0 0 12px rgba(0,255,180,.08)}
/* Replacement for the world map: animated holographic cyber radar */
.cyber-radar{
  height:300px;position:relative;overflow:hidden;isolation:isolate;
  border:1px solid rgba(56,170,255,.35);
  background:
    radial-gradient(ellipse at 50% 48%,rgba(0,206,255,.19),transparent 39%),
    radial-gradient(ellipse at 20% 85%,rgba(151,50,255,.17),transparent 42%),
    radial-gradient(ellipse at 85% 15%,rgba(0,255,190,.12),transparent 38%),
    linear-gradient(145deg,#041438,#030b26 62%,#100a36);
  box-shadow:inset 0 0 45px rgba(0,132,255,.15);
}
.radar-grid{
  position:absolute;inset:0;opacity:.30;
  background-image:linear-gradient(rgba(49,178,255,.13) 1px,transparent 1px),linear-gradient(90deg,rgba(49,178,255,.13) 1px,transparent 1px);
  background-size:34px 34px;
  mask-image:radial-gradient(ellipse at center,#000 25%,transparent 86%);
}
.radar-stage{
  position:absolute;width:min(390px,75%);aspect-ratio:1;left:50%;top:45%;
  transform:translate(-50%,-50%);border-radius:50%;
  background:radial-gradient(circle,rgba(13,93,174,.17),rgba(4,21,65,.1) 58%,transparent 70%);
}
.radar-ring{
  position:absolute;inset:0;border:1px solid rgba(46,194,255,.37);border-radius:50%;
  box-shadow:0 0 13px rgba(0,166,255,.12),inset 0 0 13px rgba(0,166,255,.08);
}
.ring-two{inset:15%;border-color:rgba(147,91,255,.45)}
.ring-three{inset:31%;border-color:rgba(47,238,220,.42)}
.radar-cross{position:absolute;background:rgba(64,168,255,.20)}
.cross-horizontal{height:1px;left:0;right:0;top:50%}
.cross-vertical{width:1px;top:0;bottom:0;left:50%}
.radar-sweep{
  position:absolute;inset:0;border-radius:50%;
  background:conic-gradient(from 0deg,transparent 0deg,rgba(0,214,255,.03) 230deg,rgba(0,229,255,.26) 310deg,rgba(0,229,255,.02) 360deg);
  animation:radarRotate 5.5s linear infinite;
  filter:drop-shadow(0 0 9px rgba(0,214,255,.4));
}
.radar-sweep::after{
  content:"";position:absolute;top:0;left:50%;height:50%;width:2px;transform-origin:bottom;
  background:linear-gradient(transparent,#54f5ff);box-shadow:0 0 12px #23eaff;
}
@keyframes radarRotate{to{transform:rotate(360deg)}}
.radar-core{
  position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:104px;height:104px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:radial-gradient(circle at 40% 30%,rgba(21,135,255,.56),rgba(8,22,68,.96) 70%);
  border:1px solid rgba(64,220,255,.72);
  box-shadow:0 0 24px rgba(0,190,255,.4),0 0 55px rgba(102,61,255,.25),inset 0 0 22px rgba(45,189,255,.22);
}
.radar-core span{font-size:38px;filter:drop-shadow(0 0 9px #20dfff)}
.radar-core small{font-size:8px;line-height:1.2;text-align:center;letter-spacing:1.3px;color:#a8eaff;font-weight:800}
.radar-node{position:absolute;width:12px;height:12px;border-radius:50%;z-index:3;animation:nodePulse 1.8s ease-in-out infinite}
.radar-node::after{content:"";position:absolute;inset:-7px;border:1px solid currentColor;border-radius:50%;opacity:.65;animation:nodeRipple 1.8s ease-out infinite}
.node-a{left:19%;top:28%;background:#ff4f83;color:#ff4f83;box-shadow:0 0 17px #ff397f}
.node-b{right:18%;top:22%;background:#ffb34f;color:#ffb34f;box-shadow:0 0 17px #ff9d35;animation-delay:.4s}
.node-c{right:22%;bottom:22%;background:#35e9ff;color:#35e9ff;box-shadow:0 0 17px #35e9ff;animation-delay:.8s}
.node-d{left:22%;bottom:20%;background:#b66aff;color:#b66aff;box-shadow:0 0 17px #b66aff;animation-delay:1.1s}
.node-e{left:50%;top:10%;background:#36ffc4;color:#36ffc4;box-shadow:0 0 17px #36ffc4;animation-delay:1.4s}
@keyframes nodePulse{50%{transform:scale(1.35);filter:brightness(1.5)}}
@keyframes nodeRipple{0%{transform:scale(.55);opacity:.8}100%{transform:scale(2.2);opacity:0}}
.radar-label{position:absolute;font-size:8px;letter-spacing:1px;font-weight:900;color:#8ecfff;text-shadow:0 0 8px #168bff}
.label-a{left:-7%;top:30%;color:#ff8eb5}.label-b{right:-8%;top:24%;color:#8df4ff}.label-c{right:-7%;bottom:21%;color:#8fffdc}
.radar-signal{
  position:absolute;z-index:4;padding:7px 10px;border:1px solid rgba(65,174,255,.38);border-radius:9px;
  background:rgba(4,17,48,.84);box-shadow:0 0 17px rgba(0,144,255,.13);
  color:#5deaff;font-size:10px;backdrop-filter:blur(8px);
}
.radar-signal b{font-size:9px;letter-spacing:.8px;color:#e8f6ff}
.radar-signal small{display:block;color:#9cb8d8;font-size:8px;margin-top:3px}
.signal-a{left:-13%;bottom:23%;border-color:rgba(255,87,145,.4);color:#ff7da9}
.signal-b{right:-16%;top:45%;border-color:rgba(52,255,201,.4);color:#43ffd0}
.radar-footer{
  position:absolute;left:0;right:0;bottom:0;height:42px;display:flex;align-items:center;gap:18px;padding:0 15px;
  background:linear-gradient(90deg,rgba(5,13,42,.94),rgba(10,18,53,.82));
  border-top:1px solid rgba(63,150,255,.23);color:#d6e9ff;font-size:10px;
}
.radar-footer span{display:flex;align-items:center;gap:7px}
.signal-dot{width:8px;height:8px;border-radius:50%;display:inline-block}
.dot-red{background:#ff4f83;box-shadow:0 0 9px #ff4f83}
.dot-cyan{background:#35e9ff;box-shadow:0 0 9px #35e9ff}
.radar-status{margin-left:auto;color:#58f5c6;font-weight:900;letter-spacing:.7px}
.radar-status i{width:7px;height:7px;border-radius:50%;background:#31ffc0;box-shadow:0 0 9px #31ffc0}
@media(max-width:650px){
  .cyber-radar{height:230px}
  .radar-stage{width:min(280px,78%);top:44%}
  .radar-signal{display:none}
  .radar-label{font-size:6px}
  .radar-footer{gap:8px;padding:0 8px;font-size:8px}
  .radar-status{letter-spacing:0}
}
@media(prefers-reduced-motion:reduce){
  .radar-sweep,.radar-node,.radar-node::after{animation:none!important}
}
</style>


<style id="vapp-cyber-intelligence-panels">
/* Multi-panel cyber intelligence visual, replacing the geographic map/radar */
.cyber-intel-board{
  height:356px;min-height:356px;padding:10px;box-sizing:border-box;overflow:hidden;
  border:1px solid rgba(80,150,255,.42);border-radius:17px;position:relative;isolation:isolate;
  background:
    radial-gradient(ellipse at 15% 0%,rgba(0,219,255,.14),transparent 34%),
    radial-gradient(ellipse at 88% 8%,rgba(195,62,255,.16),transparent 34%),
    radial-gradient(ellipse at 50% 100%,rgba(255,66,177,.09),transparent 40%),
    linear-gradient(145deg,#030d28 0%,#07102e 48%,#080b2b 100%);
  box-shadow:inset 0 0 38px rgba(30,116,255,.13),0 0 22px rgba(32,122,255,.12);
}
.cyber-intel-board::before{
  content:"";position:absolute;inset:0;pointer-events:none;opacity:.23;z-index:-1;
  background-image:linear-gradient(rgba(54,171,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(54,171,255,.12) 1px,transparent 1px);
  background-size:25px 25px;mask-image:linear-gradient(transparent,#000 15%,#000 90%,transparent);
}
.intel-grid{
  height:calc(100% - 28px);display:grid;grid-template-columns:1.22fr .88fr;
  grid-template-rows:1fr 1.06fr;gap:9px;min-height:0;
}
.intel-tile{
  min-width:0;min-height:0;position:relative;overflow:hidden;padding:9px 10px 7px;
  border:1px solid rgba(75,159,255,.27);border-radius:11px;
  background:linear-gradient(145deg,rgba(8,29,69,.88),rgba(5,12,39,.91));
  box-shadow:inset 0 0 20px rgba(54,124,255,.08),0 5px 14px rgba(0,0,0,.18);
}
.intel-tile::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,rgba(255,255,255,.035),transparent 38%,rgba(91,73,255,.035))}
.intel-tile-head{height:17px;display:flex;align-items:center;justify-content:space-between;gap:6px;position:relative;z-index:2;color:#dff4ff;font-size:9px;font-weight:900;letter-spacing:1px;white-space:nowrap}
.intel-tile-head small{font-size:7px;color:#769ac7;letter-spacing:.8px;font-weight:700}
.intel-live-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#2effc3;box-shadow:0 0 8px #2effc3;margin-right:5px;animation:intelBlink 1.5s ease-in-out infinite}
@keyframes intelBlink{50%{opacity:.35;box-shadow:0 0 2px #2effc3}}
.signal-chart{position:absolute;left:10px;right:10px;top:30px;bottom:23px;overflow:hidden}
.signal-gridlines,.intensity-gridlines{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between}
.signal-gridlines i,.intensity-gridlines i{display:block;border-top:1px solid rgba(91,155,255,.13)}
.signal-bars{position:absolute;inset:8px 2px 0;display:flex;align-items:flex-end;gap:4px}
.signal-bars b{flex:1;height:var(--h);min-width:2px;border-radius:3px 3px 0 0;background:linear-gradient(180deg,#39f6ff 0%,#178bff 52%,rgba(89,74,255,.28) 100%);box-shadow:0 0 9px rgba(25,201,255,.25);opacity:.8;animation:signalRise 2.8s ease-in-out infinite alternate}
.signal-bars b:nth-child(3n){background:linear-gradient(180deg,#e77bff,#9b4cff 65%,rgba(137,56,255,.18));animation-delay:.3s}
.signal-bars b:nth-child(4n){background:linear-gradient(180deg,#ff82d7,#ed4fae 65%,rgba(237,79,174,.18));animation-delay:.7s}
@keyframes signalRise{to{filter:brightness(1.35);opacity:1}}
.signal-line{position:absolute;inset:0;width:100%;height:100%;filter:drop-shadow(0 0 5px rgba(67,226,255,.55));overflow:visible}
.intel-axis{position:absolute;bottom:5px;left:11px;right:11px;display:flex;justify-content:space-between;color:#7295bf;font-size:7px;letter-spacing:.7px}
.gauge-tile{background:radial-gradient(ellipse at 50% 90%,rgba(117,49,255,.13),transparent 60%),linear-gradient(145deg,rgba(15,23,72,.94),rgba(5,12,39,.96))}
.mini-gauges{height:calc(100% - 24px);display:flex;align-items:center;justify-content:space-around;gap:4px;padding-top:4px}
.mini-gauge{display:flex;flex-direction:column;align-items:center;gap:4px;min-width:0}
.gauge-arc{width:clamp(45px,6vw,68px);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;position:relative;background:conic-gradient(from 215deg,var(--gauge-color) 0 76%,rgba(76,111,177,.15) 76% 100%);box-shadow:0 0 14px color-mix(in srgb,var(--gauge-color) 30%,transparent)}
.gauge-arc::before{content:"";position:absolute;inset:6px;border-radius:50%;background:radial-gradient(circle at 35% 25%,#122b62,#050e2b 72%);border:1px solid rgba(127,174,255,.2)}
.gauge-arc::after{content:"";position:absolute;inset:-4px;border:1px solid color-mix(in srgb,var(--gauge-color) 38%,transparent);border-radius:50%;animation:gaugeGlow 2.5s ease-in-out infinite}
.gauge-arc span{z-index:1;color:var(--gauge-color);font-size:23px;text-shadow:0 0 12px var(--gauge-color)}
.mini-gauge>b{font-size:7px;letter-spacing:.7px;color:#e8f4ff}
.mini-gauge>small{font-size:6px;color:#7fa3d0;letter-spacing:.8px}
.gauge-cyan{--gauge-color:#27eaff}.gauge-pink{--gauge-color:#ff5cc8}.gauge-gold{--gauge-color:#ffc45c}
@keyframes gaugeGlow{50%{opacity:.35;transform:scale(1.05)}}
.intensity-chart{position:absolute;left:10px;right:10px;top:30px;bottom:22px;overflow:hidden}
.intensity-bars{position:absolute;inset:4px 2px 0;display:flex;align-items:flex-end;gap:3px}
.intensity-bars b{flex:1;min-width:2px;height:var(--h);border-radius:2px 2px 0 0;background:linear-gradient(180deg,#ff73cf 0%,#dc3ebc 45%,rgba(116,50,255,.2) 100%);box-shadow:0 0 8px rgba(245,61,190,.22);animation:intensityPulse 3.2s ease-in-out infinite alternate}
.intensity-bars b:nth-child(n+10):nth-child(-n+18){background:linear-gradient(180deg,#ffc968,#ff963c 55%,rgba(255,135,57,.17));box-shadow:0 0 8px rgba(255,163,66,.22)}
.intensity-bars b:nth-child(n+19){background:linear-gradient(180deg,#3af5ff,#1c9fff 55%,rgba(28,159,255,.16));box-shadow:0 0 8px rgba(35,200,255,.24)}
.intensity-bars b:nth-child(3n){animation-delay:.5s}
@keyframes intensityPulse{to{filter:brightness(1.35);opacity:.78}}
.network-visual{position:absolute;left:5px;right:5px;top:26px;bottom:24px}
.network-visual svg{width:100%;height:100%;overflow:visible;filter:drop-shadow(0 0 5px rgba(42,196,255,.15))}
.network-ripple{transform-origin:center;animation:networkRipple 2.2s ease-out infinite}
.ripple-two{animation-delay:1s;stroke:#ff62c8}
@keyframes networkRipple{0%{opacity:.85;transform:scale(.6)}100%{opacity:0;transform:scale(2.1)}}
.network-chip{position:absolute;padding:4px 6px;border-radius:5px;background:rgba(4,15,43,.88);border:1px solid rgba(66,177,255,.3);color:#8eb5df;font-size:6px;letter-spacing:.5px}
.network-chip b{color:#47f1d0;margin-left:4px}
.chip-left{left:5px;bottom:2px}.chip-right{right:5px;top:0}
.network-legend{position:absolute;bottom:5px;left:10px;right:10px;display:flex;gap:10px;justify-content:center;color:#89a9d1;font-size:6px}
.network-legend span{display:flex;align-items:center;gap:4px;white-space:nowrap}
.network-legend i{width:5px;height:5px;border-radius:50%;display:inline-block}
.net-cyan{background:#27eaff;box-shadow:0 0 6px #27eaff}.net-pink{background:#ff62c8;box-shadow:0 0 6px #ff62c8}.net-gold{background:#ffc45c;box-shadow:0 0 6px #ffc45c}
.intel-footer{height:21px;display:flex;align-items:flex-end;gap:15px;padding:0 4px;color:#7899c3;font-size:7px;font-weight:800;letter-spacing:.8px}
.intel-footer b{color:#35ffc1;font-size:9px}
.intel-footer-right{margin-left:auto;color:#5ee9ff}
@media(max-width:680px){
  .cyber-intel-board{height:440px;min-height:440px}
  .intel-grid{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:7px}
  .intel-tile{padding:7px 6px}
  .intel-tile-head{font-size:7px}.intel-tile-head small{font-size:6px}
  .network-legend{gap:5px;font-size:5px}
  .intel-footer{font-size:6px;gap:7px}
}
@media(prefers-reduced-motion:reduce){
  .intel-live-dot,.signal-bars b,.intensity-bars b,.gauge-arc::after,.network-ripple{animation:none!important}
}
</style>


<style id="vapp-final-unified-dashboard">
/* Final VAPP research-aligned dashboard refinements */
.sidebar {
  width: 238px;
  padding: 13px 11px 12px;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(45,150,255,.35) transparent;
}
.main { margin-left: 238px; }
.brand { padding-bottom: 10px; margin-bottom: 10px; }
.shield-logo {
  width: 88px; height: 88px; margin: 0 auto 2px;
  border: 0; border-radius: 0; background: transparent;
  box-shadow: none; transform: none; overflow: visible;
}
.shield-logo img {
  width: 100%; height: 100%; display: block; object-fit: contain;
  filter: drop-shadow(0 0 9px rgba(0,145,255,.28));
}
.brand-name {
  margin-top: 0; font-size: 29px; letter-spacing: 3px;
  color: #55cfff; background: none; -webkit-text-fill-color: #55cfff;
  text-shadow: none; filter: none;
}
.brand-sub { margin-top: 2px; font-size: 9px; line-height: 1.3; letter-spacing: .8px; }
.nav { gap: 3px; }
.nav-item {
  min-height: 43px; padding: 8px 10px; gap: 10px;
  border-radius: 11px; font-size: 12px; white-space: nowrap;
}
.nav-icon { width: 23px; flex: 0 0 23px; font-size: 17px; filter: none; }
.nav-item:hover { transform: none; }
.nav-item.active { box-shadow: inset 0 0 10px rgba(30,163,255,.08); }
.content { padding: 14px 19px 25px; }
.hero.vapp-hero { height: 150px; margin-bottom: 16px; border-radius: 19px; }
.hero-shield {
  width: 116px; height: 116px; flex: 0 0 116px;
  display: grid; place-items: center; overflow: hidden;
  border: 1px solid rgba(39,202,255,.42); border-radius: 50%;
  background: radial-gradient(circle,rgba(0,194,255,.15),rgba(0,50,180,.06) 58%,transparent 72%);
  box-shadow: 0 0 18px rgba(0,162,255,.2);
}
.hero-shield::before { content: none; }
.hero-shield img { width: 112%; height: 112%; object-fit: contain; display:block; }
.hero-copy h1, .panel-title, .stat-value, .brand-name {
  text-shadow: none !important;
  filter: none !important;
}
.hero-copy h1 { color: #f3f7ff; }
.hero-copy p { color: #d0e1ff; }
.stat-value { text-shadow: none !important; }
.stat-icon { filter: none !important; }
.stats { gap: 14px; margin-bottom: 17px; }
.stat { min-height: 145px; padding: 17px 18px; border-radius: 17px; }
.stat-title { color: #e0eaff; font-size: 11px; letter-spacing: .35px; }
.stat-foot { color: #c0d0e7; font-size: 10px; }
.two { gap: 16px; margin-bottom: 17px; }
.panel { padding: 17px; }
.panel-head { margin-bottom: 13px; }
.panel-title { color: #f2f6ff; font-size: 17px; }
.panel-sub { color: #a7bbdc; font-size: 10px; }
.live-tag { box-shadow: none; }
/* Keep the four-panel cyber activity visual; no geographic/world map is introduced. */
.activity.cyber-intel-board { height: 280px; }
/* Remove decorative text glow throughout the interface while retaining soft panel lighting. */
.sidebar *, .topbar *, .content h1, .content h2, .content h3,
.panel-title, .stat-title, .stat-foot, .nav-item {
  text-shadow: none !important;
}
@media (max-height: 820px) and (min-width: 901px) {
  .sidebar { padding-top: 8px; padding-bottom: 8px; }
  .brand { padding-bottom: 7px; margin-bottom: 7px; }
  .shield-logo { width: 68px; height: 68px; }
  .brand-name { font-size: 25px; }
  .brand-sub { font-size: 8px; }
  .nav { gap: 1px; }
  .nav-item { min-height: 38px; padding-top: 6px; padding-bottom: 6px; }
}
@media(max-width:1000px) {
  .sidebar { width:76px; padding:20px 9px; }
  .main { margin-left:76px; }
}
</style>


<style id="vapp-left-panel-reference">
.sidebar { width: 238px; padding: 13px 11px 18px; }
.main { margin-left: 238px; }
.nav { display:flex; flex-direction:column; gap:7px; }
.nav-item {
  min-height:51px; padding:11px 12px; display:flex; align-items:center;
  gap:13px; border-radius:13px; font-size:14px; white-space:nowrap;
  color:#b6c9e6; border:1px solid transparent; border-left:3px solid transparent;
}
.nav-icon {
  width:25px; min-width:25px; text-align:center; font-size:19px;
  display:inline-flex; align-items:center; justify-content:center;
  filter:none;
}
.nav-item.active {
  color:#fff; border:1px solid rgba(40,197,255,.82);
  border-left:3px solid #36e0ff;
  background:linear-gradient(105deg,rgba(0,174,255,.30),rgba(43,61,194,.25));
  box-shadow:0 0 14px rgba(0,145,255,.35),inset 0 0 14px rgba(30,163,255,.10);
}
.nav-item:hover { transform:none; color:#fff; }
@media(max-width:1000px) {
  .sidebar { width:76px; padding:20px 9px; }
  .main { margin-left:76px; }
  .nav-item { justify-content:center; padding:12px 5px; }
  .nav-item span { display:none; }
}
</style>

</head>
<body>

<aside class="sidebar">
    <div class="brand">
        <div class="shield-logo"><img src="data:image/png;base64," alt="VAPP metallic blue shield and padlock"></div>
        <div class="brand-name">VAPP</div>
        <div class="brand-sub">VISIONARY AI PROTECTION PLATFORM</div>
    </div>

    <nav class="nav" aria-label="Main navigation">
        <a class="nav-item active" href="#event-logs" data-communication-view="all"><div class="nav-icon">🗂️</div><span>All Communications</span></a>
        <a class="nav-item" href="#event-logs" data-communication-view="email" aria-label="Email Monitoring"><div class="nav-icon">✉️</div><span>Email Monitoring</span></a>
        <a class="nav-item" href="#event-logs" data-communication-view="sms" aria-label="SMS Monitoring"><div class="nav-icon">📱</div><span>SMS Monitoring</span></a>
        <a class="nav-item" href="#threats"><div class="nav-icon">🚨</div><span>Threats</span></a>
        <a class="nav-item" href="#incidents"><div class="nav-icon">🔥</div><span>Incidents</span></a>
        <a class="nav-item" href="#event-logs"><div class="nav-icon">📡</div><span>Event Logs</span></a>
        <a class="nav-item" href="#analytics"><div class="nav-icon">📊</div><span>Analytics</span></a>
        <a class="nav-item" href="#reports"><div class="nav-icon">📄</div><span>Reports</span></a>
        <a class="nav-item" href="#settings"><div class="nav-icon">⚙️</div><span>Settings</span></a>
    </nav>
</aside>

<main class="main">
<header class="topbar">
    <form class="search-form" onsubmit="return performSearch(event)">
        <input id="globalSearch" type="text" placeholder="🔍 Search events, threats, IPs...">
        <button type="submit">⌕</button>
    </form>
    <div class="top-right">
        <div class="system"><div class="system-dot"></div>SYSTEM ONLINE</div>
        <div class="user">🔔 <div class="user-icon">👤</div>{{ user_name }}</div>
    </div>
</header>

<div class="content" id="dashboard">

<section class="card panel" id="communicationViewPanel" style="margin-bottom:17px">
    <div class="panel-head" style="margin-bottom:10px">
        <div><div class="panel-title">🛡️ Communication Monitoring</div>
        <div class="panel-sub" id="communicationViewDescription">Combined Email and SMS event history for your account</div></div>
        <div class="live-tag" id="communicationViewBadge">ALL COMMUNICATIONS</div>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="report-btn" href="/api/report.csv?channel=all">⬇ ALL COMMUNICATIONS CSV</a>
        <a class="report-btn" href="/api/report.csv?channel=email">⬇ EMAIL CSV</a>
        <a class="report-btn" href="/api/report.csv?channel=sms">⬇ SMS CSV</a>
    </div>
</section>

<section class="hero vapp-hero">
    <div class="hero-shield" aria-hidden="true"><img src="data:image/png;base64," alt=""></div>
    <div class="hero-copy">
        <h1>Security Command Center</h1>
        <p>AI-assisted cyber threat detection, risk prioritization and adaptive defense</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <div class="hero-world"></div>
        <div class="hero-orbit orbit-a"></div><div class="hero-orbit orbit-b"></div>
        <div class="hero-envelope">✉</div>
        <div class="hero-laptop"><div class="laptop-screen"><span>🛡️</span></div><div class="laptop-base"></div></div>
        <div class="hero-phone">▣</div>
    </div>
</section>

<section class="stats">
    <div class="card stat"><div class="stat-icon">🛡️</div><div class="stat-title">Total Events</div><div class="stat-value cyan" id="totalEvents">{{ total_events }}</div><div class="stat-foot">Email and SMS records</div></div>
    <div class="card stat"><div class="stat-icon">🚨</div><div class="stat-title">Flagged Events</div><div class="stat-value red" id="totalThreats">{{ total_threats }}</div><div class="stat-foot">Events requiring review</div></div>
    <div class="card stat"><div class="stat-icon">⚠️</div><div class="stat-title">High-Priority Events</div><div class="stat-value orange" id="highRisk">{{ high_risk }}</div><div class="stat-foot">Recorded high-risk events</div></div>
    <div class="card stat"><div class="stat-icon">🧠</div><div class="stat-title">AI Engine</div><div class="stat-value green">ON</div><div class="stat-foot">Random Forest + Risk Intelligence</div></div>
</section>

<section class="two">
    <div class="card panel">
        <div class="panel-head"><div><div class="panel-title">▦ Communication Event Activity</div><div class="panel-sub">Unified Email and SMS event overview</div></div><div class="live-tag">OVERVIEW</div></div>
        <div class="activity cyber-intel-board" aria-label="Live cyber intelligence analytics visualization">
            <div class="intel-grid">
                <section class="intel-tile signal-tile">
                    <div class="intel-tile-head"><span><i class="intel-live-dot"></i> EVENT SIGNAL OVERVIEW</span><small>RECORDED EVENT HISTORY · ALL TIME</small></div>
                    <div class="signal-chart">
                        <div class="signal-gridlines"><i></i><i></i><i></i><i></i></div>
                        <div class="signal-bars" id="signalBars" aria-hidden="true"></div>
                        <svg class="signal-line" viewBox="0 0 600 130" preserveAspectRatio="none" aria-hidden="true">
                            <defs><linearGradient id="signalStroke" x1="0" x2="1"><stop offset="0" stop-color="#27eaff"/><stop offset=".52" stop-color="#b65cff"/><stop offset="1" stop-color="#ff62c8"/></linearGradient></defs>
                            <path d="M0 93 C35 90 35 54 65 65 S105 108 135 73 S175 25 205 54 S245 96 275 57 S315 16 345 44 S385 88 415 54 S455 35 485 48 S535 90 565 42 S590 25 600 17" fill="none" stroke="url(#signalStroke)" stroke-width="3" vector-effect="non-scaling-stroke"/>
                        </svg>
                    </div>
                    <div class="intel-axis"><span>FIRST RECORDED</span><span>EVENT HISTORY</span><span>MOST RECENT</span></div>
                </section>

                <section class="intel-tile gauge-tile">
                    <div class="intel-tile-head"><span>CHANNEL INSIGHTS</span><small>STORED EVENT COUNTS</small></div>
                    <div class="mini-gauges" id="activityGauges">
                        <div class="mini-gauge gauge-cyan" id="emailGauge" style="--gauge-value:0%">
                            <div class="gauge-arc"><span id="emailGaugeValue">0</span></div><b>EMAIL EVENTS</b><small id="emailGaugeLabel">0 RECORDS</small>
                        </div>
                        <div class="mini-gauge gauge-pink" id="smsGauge" style="--gauge-value:0%">
                            <div class="gauge-arc"><span id="smsGaugeValue">0</span></div><b>SMS EVENTS</b><small id="smsGaugeLabel">0 RECORDS</small>
                        </div>
                        <div class="mini-gauge gauge-gold" id="flaggedGauge" style="--gauge-value:0%">
                            <div class="gauge-arc"><span id="flaggedGaugeValue">0%</span></div><b>FLAGGED RATE</b><small>OF ALL EVENTS</small>
                        </div>
                    </div>
                </section>

                <section class="intel-tile intensity-tile">
                    <div class="intel-tile-head"><span>RISK ACTIVITY PATTERN</span><small>RECORDED RISK LEVELS</small></div>
                    <div class="intensity-chart" aria-hidden="true">
                        <div class="intensity-gridlines"><i></i><i></i><i></i></div>
                        <div class="intensity-bars" id="intensityBars" aria-hidden="true"></div>
                    </div>
                    <div class="intel-axis"><span>LOW</span><span>MEDIUM / HIGH</span><span>CRITICAL</span></div>
                </section>

                <section class="intel-tile network-tile">
                    <div class="intel-tile-head"><span>COMMUNICATION CHANNELS</span><small>EMAIL / SMS BREAKDOWN</small></div>
                    <div class="network-visual channel-flow" id="channelFlow">
                        <div class="channel-node email-node">
                            <span class="channel-node-icon">✉</span>
                            <span class="channel-node-name">EMAIL</span>
                            <strong id="flowEmailCount">0</strong>
                            <small>RECORDED</small>
                        </div>
                        <div class="channel-connector"><i></i><span>VAPP EVENT STORE</span><i></i></div>
                        <div class="channel-node sms-node">
                            <span class="channel-node-icon">▣</span>
                            <span class="channel-node-name">SMS</span>
                            <strong id="flowSmsCount">0</strong>
                            <small>RECORDED</small>
                        </div>
                    </div>
                    <div class="network-legend"><span><i class="net-cyan"></i> Email records</span><span><i class="net-pink"></i> SMS records</span><span><i class="net-gold"></i> Combined storage</span></div>
                </section>
            </div>
            <div class="intel-footer"><span><i class="intel-live-dot"></i> VAPP INTELLIGENCE ENGINE</span><span>EVENT OVERVIEW <b>●</b></span><span class="intel-footer-right">SECURE ENVIRONMENT</span></div>
        </div>
    </div>
    <div class="card panel" id="analytics">
        <div class="panel-head"><div><div class="panel-title">📊 Threat Distribution</div><div class="panel-sub">Calculated from stored events</div></div></div>
        <div class="distribution donut-layout">
            <div class="donut-wrap">
                <div class="threat-donut" id="threatDonut"><div class="donut-center"><span>🛡️</span><small>VAPP<br>THREATS</small></div></div>
            </div>
            <div class="donut-legend">
                <div class="donut-item"><span class="donut-label"><i class="dot-blue"></i>Brute Force</span><strong id="bruteCount">0</strong><small id="brutePercent">0%</small></div>
                <div class="donut-item"><span class="donut-label"><i class="dot-orange"></i>Port Scan</span><strong id="scanCount">0</strong><small id="scanPercent">0%</small></div>
                <div class="donut-item"><span class="donut-label"><i class="dot-purple"></i>Suspicious / Phishing</span><strong id="suspiciousCount">0</strong><small id="suspiciousPercent">0%</small></div>
                <div class="donut-item"><span class="donut-label"><i class="dot-green"></i>Normal</span><strong id="normalCount">0</strong><small id="normalPercent">0%</small></div>
            </div>
            <div class="legacy-bars" aria-hidden="true">
                <div id="bruteBar" class="fill" style="width:0%"></div><div id="scanBar" class="fill" style="width:0%"></div>
                <div id="suspiciousBar" class="fill" style="width:0%"></div><div id="normalBar" class="fill" style="width:0%"></div>
            </div>
        </div>
    </div>
</section>

<section class="three">
    <div class="card panel">
        <div class="panel-head"><div><div class="panel-title">🧠 AI Threat Analysis</div><div class="panel-sub">Latest security event</div></div><div class="live-tag">AI ACTIVE</div></div>
        <div class="analysis">
            <div class="threat-header"><div class="threat-name" id="threatType">WAITING...</div><div class="risk" id="riskBadge">NO EVENT</div></div>
            <div class="metric"><span>🌐 Source IP</span><span id="sourceIP">—</span></div>
            <div class="metric"><span>🎯 Confidence</span><span id="confidence">—</span></div>
            <div class="metric"><span>📈 Risk Score</span><span id="riskScore">—</span></div>
            <div class="metric"><span>🕒 Timestamp</span><span id="timestamp">—</span></div>
            <div class="explain">🔎 <strong>WHY VAPP DETECTED THIS</strong><br><br><span id="explanation">Waiting for an analyzed event.</span></div>
            <div class="recommend">🛡️ <strong>DEFENSIVE RECOMMENDATION</strong><br><br><span id="recommendation">Awaiting analysis...</span></div>
        </div>
    </div>

    <div class="card panel">
        <div class="panel-head"><div><div class="panel-title">⚡ Controlled Event Testing</div><div class="panel-sub">Secondary safe demonstration</div></div><div class="live-tag">DEMO</div></div>
        <div style="color:#71869d;font-size:10px;line-height:1.6">Use these only as secondary tests. The primary Review 3 flow is the external-device email event.</div>
        <div class="sim-buttons">
            <button class="sim normal" onclick="simulate('normal')">🟢 NORMAL</button>
            <button class="sim suspicious" onclick="simulate('suspicious')">🟡 SUSPICIOUS</button>
            <button class="sim scan" onclick="simulate('port_scan')">🟠 PORT SCAN</button>
            <button class="sim brute" onclick="simulate('brute_force')">🔴 BRUTE FORCE</button>
        </div>
        <div class="pipeline">
            <div class="pipeline-title">🔐 VAPP PROCESSING PIPELINE</div>
            <div class="pipeline-step"><span>01</span>📥 Event Ingestion</div>
            <div class="pipeline-step"><span>02</span>⚙️ Feature Extraction</div>
            <div class="pipeline-step"><span>03</span>🧠 Random Forest Classification</div>
            <div class="pipeline-step"><span>04</span>⚠️ Risk Prioritization</div>
            <div class="pipeline-step"><span>05</span>🔎 Explainable Analysis</div>
            <div class="pipeline-step"><span>06</span>🛡️ Defensive Recommendation</div>
        </div>
    </div>

    <div class="card panel">
        <div class="panel-head"><div><div class="panel-title">🛡️ Protection Status</div><div class="panel-sub">Current VAPP security engines</div></div></div>
        <div style="text-align:center;padding:10px">
            <div style="font-size:55px">🛡️</div>
            <div style="color:#38bdf8;font-size:16px;font-weight:900">AI PROTECTED</div>
            <div style="color:#647b91;font-size:9px;margin-top:6px">Security intelligence active</div>
            <div style="margin-top:15px;padding:10px;border-radius:9px;background:rgba(34,197,94,.05);border:1px solid rgba(34,197,94,.18);color:#6ee7a0;font-size:10px">🟢 Detection Engine <strong>ONLINE</strong></div>
            <div style="margin-top:8px;padding:10px;border-radius:9px;background:rgba(56,189,248,.05);border:1px solid rgba(56,189,248,.18);color:#75cfff;font-size:10px">🔵 Risk Engine <strong>ACTIVE</strong></div>
            <div style="margin-top:8px;padding:10px;border-radius:9px;background:rgba(168,85,247,.05);border:1px solid rgba(168,85,247,.18);color:#c4a1ff;font-size:10px">🟣 Explainability <strong>ACTIVE</strong></div>
        </div>
    </div>
</section>

<!-- LIVE EMAIL GATEWAY -->
<section class="email-security-panel" id="live-monitoring">
    <div class="panel-head">
        <div><div class="panel-title">📧 Live Incoming Email Security Gateway</div><div class="panel-sub">External device → VAPP → detection → alert → database</div></div>
        <div class="live-tag">● GATEWAY READY</div>
    </div>
    <div class="email-grid">
        <div class="email-field"><label>Sender</label><input id="emailSender" value="security-alert@example.test"></div>
        <div class="email-field"><label>Source IP</label><input id="emailSourceIP" value="AUTO" placeholder="AUTO or 203.0.113.50"></div>
        <div class="email-field full"><label>Subject</label><input id="emailSubject" value="URGENT: Verify your account"></div>
        <div class="email-field full"><label>Message Content</label><textarea id="emailBody">Your account has been suspended. Click here to verify your account and reset your password.</textarea></div>
    </div>
    <button class="email-analyze-btn" id="emailAnalyzeButton" onclick="analyzeLiveEmail()">🔍 ANALYZE INCOMING EMAIL</button>
    <div class="email-error" id="emailError"></div>
    <div class="email-result" id="emailResult">
        <div class="email-alert-header"><div class="email-alert-title">🚨 VAPP SECURITY ALERT</div><div class="email-risk-badge" id="emailRiskBadge">HIGH RISK</div></div>
        <div class="email-result-grid">
            <div class="email-result-card"><span>Threat Type</span><strong id="emailThreatType">—</strong></div>
            <div class="email-result-card"><span>Confidence</span><strong id="emailConfidence">—</strong></div>
            <div class="email-result-card"><span>Risk Score</span><strong id="emailRiskScore">—</strong></div>
            <div class="email-result-card"><span>Source IP</span><strong id="emailDetectedIP">—</strong></div>
            <div class="email-result-card"><span>Event ID</span><strong id="emailEventID">—</strong></div>
            <div class="email-result-card"><span>Status</span><strong id="emailStatus">—</strong></div>
        </div>
        <div class="email-result-text"><strong>🔎 Matched Indicators:</strong> <span id="emailIndicators">—</span></div>
        <div class="email-result-text"><strong>🧠 VAPP Analysis:</strong> <span id="emailExplanation">—</span></div>
        <div class="email-result-text"><strong>🛡️ Recommended Action:</strong> <span id="emailRecommendation">—</span></div>
        <div class="email-saved">✓ Event stored in the VAPP database and linked to the monitored user.</div>
    </div>
</section>

<!-- SMS CSV IMPORT -->
<section class="sms-import-panel" id="sms-import">
    <div class="panel-head">
        <div><div class="panel-title">📱 SMS Threat Analysis — CSV Import</div><div class="panel-sub">Upload SMS records → analyze message text → save results to the VAPP database</div></div>
        <div class="live-tag">CSV ANALYZER</div>
    </div>
    <form id="smsImportForm">
        <div class="sms-upload-row">
            <input id="smsCsvFile" name="file" type="file" accept=".csv,text/csv" required aria-label="Choose SMS CSV file">
            <button class="sms-import-btn" id="smsImportButton" type="submit">📥 IMPORT & ANALYZE SMS</button>
        </div>
    </form>
    <div class="sms-help">CSV format: include a <strong>message</strong> column (or body, text, or sms). An optional <strong>sender</strong> column is supported. Maximum 500 messages and 1 MB per file. Results are rule-based indicators, not a guarantee that a message is safe or malicious.</div>
    <div id="smsImportStatus" class="sms-status" role="status" aria-live="polite"></div>
    <div id="smsImportResults" class="sms-results">
        <div class="panel-title" style="margin:15px 0 10px">Latest import results</div>
        <div class="table-wrap"><table><thead><tr><th>Event ID</th><th>Sender</th><th>Threat Classification</th><th>Confidence</th><th>Risk Score</th><th>Risk Level</th></tr></thead><tbody id="smsResultsTable"></tbody></table></div>
    </div>
</section>

<!-- THREATS -->
<section class="card module-panel" id="threats">
    <div class="panel-head"><div><div class="panel-title">🚨 Threats</div><div class="panel-sub">All non-normal events detected by VAPP</div></div><div class="live-tag" id="threatStatus">LIVE</div></div>
    <div class="module-grid">
        <div class="module-stat"><small>Total Threats</small><strong id="threatModuleCount">0</strong></div>
        <div class="module-stat"><small>High / Critical</small><strong id="threatHighCount">0</strong></div>
        <div class="module-stat"><small>Medium</small><strong id="threatMediumCount">0</strong></div>
        <div class="module-stat"><small>Latest Threat</small><strong id="latestThreatName" style="font-size:13px">—</strong></div>
    </div>
    <div class="table-wrap" style="margin-top:15px">
        <table><thead><tr><th>Time</th><th>Source</th><th>Threat</th><th>Confidence</th><th>Score</th><th>Level</th></tr></thead>
        <tbody id="threatTable"></tbody></table>
    </div>
</section>

<!-- INCIDENTS -->
<section class="card module-panel" id="incidents">
    <div class="panel-head"><div><div class="panel-title">🔥 Incidents</div><div class="panel-sub">High and critical events requiring attention</div></div><div class="live-tag">PRIORITY</div></div>
    <div class="module-list" id="incidentList"><div style="color:#7890a8;font-size:10px">No high-risk incidents recorded.</div></div>
</section>

<!-- EVENT LOGS -->
<section class="card module-panel" id="event-logs">
    <div class="panel-head"><div><div class="panel-title">📡 Event Logs</div><div class="panel-sub">Complete monitored-event history</div></div><div class="live-tag">AUTO REFRESH 3s</div></div>
    <input class="event-filter" id="eventFilter" oninput="renderAll(currentEvents)" placeholder="Filter logs by IP, event, threat or risk level...">
    <div class="table-wrap"><table><thead><tr><th>ID</th><th>Time</th><th>Source</th><th>Event</th><th>Threat</th><th>Score</th><th>Risk</th></tr></thead><tbody id="allEventTable"></tbody></table></div>
</section>

<!-- ANALYTICS -->
<section class="card module-panel">
    <div class="panel-head"><div><div class="panel-title">📊 Analytics</div><div class="panel-sub">Real values calculated from the security database</div></div></div>
    <div class="module-grid">
        <div class="module-stat"><small>Total Events</small><strong id="analyticsTotal">0</strong></div>
        <div class="module-stat"><small>Threat Rate</small><strong id="analyticsThreatRate">0%</strong></div>
        <div class="module-stat"><small>High Risk</small><strong id="analyticsHigh">0</strong></div>
        <div class="module-stat"><small>Normal</small><strong id="analyticsNormal">0</strong></div>
    </div>
</section>

<!-- REPORTS -->
<section class="card module-panel" id="reports">
    <div class="panel-head"><div><div class="panel-title">📄 Reports</div><div class="panel-sub">Export the current user's stored VAPP security events</div></div></div>
    <div class="module-grid">
        <div class="module-stat"><small>Events</small><strong id="reportEvents">0</strong></div>
        <div class="module-stat"><small>Threats</small><strong id="reportThreats">0</strong></div>
        <div class="module-stat"><small>High Risk</small><strong id="reportHigh">0</strong></div>
        <div class="module-stat"><small>System</small><strong style="font-size:13px">READY</strong></div>
    </div>
    <div style="margin-top:15px;display:flex;gap:10px;flex-wrap:wrap">
        <a class="report-btn" href="/api/report.csv?channel=all">⬇ ALL COMMUNICATIONS CSV</a>
        <a class="report-btn" href="/api/report.csv?channel=email">⬇ EMAIL CSV</a>
        <a class="report-btn" href="/api/report.csv?channel=sms">⬇ SMS CSV</a>
    </div>
</section>

<!-- SETTINGS -->
<section class="card module-panel" id="settings">
    <div class="panel-head"><div><div class="panel-title">⚙️ Settings & System Status</div><div class="panel-sub">Current VAPP runtime configuration</div></div></div>
    <div class="setting-row"><span>🧠 ML Detection Engine</span><span class="status-online">ONLINE</span></div>
    <div class="setting-row"><span>⚠️ Risk Engine</span><span class="status-online">ACTIVE</span></div>
    <div class="setting-row"><span>🔎 Explainability Engine</span><span class="status-online">ACTIVE</span></div>
    <div class="setting-row"><span>📡 Live Event Monitoring</span><span class="status-online">ENABLED</span></div>
    <div class="setting-row"><span>🔄 Auto Refresh</span><button class="report-btn" id="refreshToggle" onclick="toggleRefresh()">ON</button></div>
    <div class="setting-row"><span>👤 Logged-in User</span><span>{{ user_name }}</span></div>
    <div class="setting-row"><span>📧 Connected Gmail</span><span id="gmailAccountStatus">Checking…</span></div>
    <div class="setting-row" style="gap:10px;flex-wrap:wrap">
        <a class="report-btn" id="gmailConnectButton" href="/auth/google/connect">CONNECT GMAIL</a>
        <button class="report-btn" id="gmailStartButton" type="button" onclick="gmailControl('start')" disabled>START MONITOR</button>
        <button class="report-btn" id="gmailStopButton" type="button" onclick="gmailControl('stop')" disabled>STOP MONITOR</button>
        <button class="report-btn" id="gmailDisconnectButton" type="button" onclick="gmailControl('disconnect')" disabled>DISCONNECT</button>
    </div>
    <div id="gmailControlStatus" role="status" aria-live="polite" style="font-size:11px;color:var(--muted);margin:8px 0 14px">Connect your own Gmail account to enable mailbox monitoring.</div>
    <div class="setting-row"><span>🛡️ External Demo Sender</span><a class="report-btn" href="/sender" target="_blank">OPEN SENDER</a></div>
    <div class="setting-row"><span>🖥️ SOC / Admin View</span><a class="report-btn" href="/admin" target="_blank">OPEN SOC</a></div>
</section>

<section class="card panel" style="margin-top:17px" id="eventTableSection">
    <div class="panel-head"><div><div class="panel-title">📡 Recent Security Events</div><div class="panel-sub">Latest events analyzed by VAPP</div></div><div class="live-tag">AUTO REFRESH 3s</div></div>
    <div class="table-wrap">
        <table><thead><tr><th>Time</th><th>Source IP</th><th>Event</th><th>Threat</th><th>Confidence</th><th>Risk Score</th><th>Level</th></tr></thead>
        <tbody id="eventTable"></tbody></table>
    </div>
</section>

<div class="footer">🛡️ VAPP — Visionary AI Protection Platform &nbsp;•&nbsp; AI-assisted Cyber Threat Cognition & Adaptive Defense</div>

</div>
</main>

<script>
let currentEvents = [];
let refreshEnabled = true;
let activeCommunicationView = "all";

function isEmailEvent(e) {
    return String(e.protocol || "").trim().toUpperCase() === "EMAIL" ||
        /email/i.test(String(e.event_type || ""));
}
function isSmsEvent(e) {
    return String(e.protocol || "").trim().toUpperCase() === "SMS" ||
        /sms/i.test(String(e.event_type || ""));
}
function getEventRisk(e) {
    return String(e.risk_level || e.severity || "").trim().toUpperCase();
}
function isThreatEvent(e) {
    const threat = String(e.threat_type || "").trim();
    return (Boolean(threat) && threat.toLowerCase() !== "normal") ||
        ["MEDIUM", "HIGH", "CRITICAL"].includes(getEventRisk(e));
}
function isNormalEvent(e) {
    const threat = String(e.threat_type || "").trim();
    return (!threat || threat.toLowerCase() === "normal") &&
        !["MEDIUM", "HIGH", "CRITICAL"].includes(getEventRisk(e));
}
function getViewEvents(events) {
    if (activeCommunicationView === "email") return events.filter(isEmailEvent);
    if (activeCommunicationView === "sms") return events.filter(isSmsEvent);
    return events;
}
function setCommunicationView(view) {
    activeCommunicationView = ["all", "email", "sms"].includes(view) ? view : "all";
    const labels = {
        all: ["ALL COMMUNICATIONS", "Combined Email and SMS event history for your account"],
        email: ["EMAIL MONITORING", "Email events only — counters, charts, threats and event logs"],
        sms: ["SMS MONITORING", "SMS events only — counters, charts, threats and event logs"]
    };
    const label = labels[activeCommunicationView];
    const badge = document.getElementById("communicationViewBadge");
    const description = document.getElementById("communicationViewDescription");
    if (badge) badge.textContent = label[0];
    if (description) description.textContent = label[1];
    document.querySelectorAll("[data-communication-view]").forEach(link => {
        const active = link.dataset.communicationView === activeCommunicationView;
        link.classList.toggle("active", active);
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
    });
    renderAll(currentEvents);
}
document.querySelectorAll("[data-communication-view]").forEach(link => {
    link.addEventListener("click", event => {
        event.preventDefault();
        setCommunicationView(link.dataset.communicationView);
        document.getElementById("event-logs")?.scrollIntoView({behavior:"smooth", block:"start"});
    });
});

function esc(value) {
    return String(value ?? "—").replace(/[&<>"']/g, c => ({
        "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
    }[c]));
}

function riskClass(level) {
    return ["LOW","MEDIUM","HIGH","CRITICAL"].includes(level) ? level : "LOW";
}

function formatVappTimestamp(timestamp) {
    if (!timestamp) return "—";

    // SQLite CURRENT_TIMESTAMP values are stored in UTC.
    const utcTimestamp = /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/.test(timestamp)
        ? timestamp.replace(" ", "T") + "Z"
        : timestamp;

    const date = new Date(utcTimestamp);

    if (Number.isNaN(date.getTime())) return timestamp;

    return date.toLocaleString("en-IN", {
        timeZone: "Asia/Kolkata",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: true
    });
}

function updateAI(event) {
    if (!event) return;
    document.getElementById("threatType").textContent = event.threat_type || "Normal";
    document.getElementById("sourceIP").textContent = event.source_ip || "—";
    document.getElementById("confidence").textContent = (event.confidence ?? 0) + "%";
    document.getElementById("riskScore").textContent = event.risk_score ?? 0;
    document.getElementById("timestamp").textContent =
    formatVappTimestamp(event.timestamp);
    document.getElementById("explanation").textContent = event.explanation || "No explanation available.";
    document.getElementById("recommendation").textContent = event.recommendation || "Continue monitoring.";
    const badge = document.getElementById("riskBadge");
    badge.textContent = event.risk_level || "LOW";
    badge.className = "risk " + riskClass(event.risk_level);
}

function showEventDetails(selectedEvent) {
    // Avoid stacking multiple event-detail dialogs.
    document.getElementById("vappEventModal")?.remove();

    const modal = document.createElement("div");
    modal.id = "vappEventModal";
    modal.setAttribute("role", "dialog");
    modal.setAttribute("aria-modal", "true");
    modal.setAttribute("aria-labelledby", "vappEventModalTitle");
    modal.style.cssText = `
        position:fixed; inset:0; z-index:99999;
        background:rgba(0,0,0,.78); backdrop-filter:blur(7px);
        display:flex; align-items:center; justify-content:center;
        padding:20px;
    `;

    const panel = document.createElement("div");
    panel.style.cssText = `
        width:min(650px,100%); max-height:85vh; overflow-y:auto;
        box-sizing:border-box; padding:24px; border-radius:16px;
        color:#eaf2ff; background:linear-gradient(145deg,#10243a,#071321);
        border:1px solid rgba(56,189,248,.45);
        box-shadow:0 24px 70px rgba(0,0,0,.55);
    `;

    const header = document.createElement("div");
    header.style.cssText = "display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px;";
    const heading = document.createElement("h2");
    heading.id = "vappEventModalTitle";
    heading.textContent = `🛡️ Event #${selectedEvent.id} Details`;
    heading.style.cssText = "margin:0;font-size:20px;";
    const closeTop = document.createElement("button");
    closeTop.type = "button";
    closeTop.textContent = "✕";
    closeTop.setAttribute("aria-label", "Close event details");
    closeTop.style.cssText = "border:0;border-radius:8px;padding:8px 12px;background:#1b334b;color:#fff;cursor:pointer;font-size:16px;";
    header.append(heading, closeTop);
    panel.appendChild(header);

    const details = [
        ["Time", formatVappTimestamp(selectedEvent.timestamp)],
        ["Source IP", selectedEvent.source_ip],
        ["Event Type", selectedEvent.event_type],
        ["Threat", selectedEvent.threat_type || "Normal"],
        ["Risk Level", selectedEvent.risk_level || "LOW"],
        ["Risk Score", selectedEvent.risk_score ?? "N/A"],
        ["Confidence", selectedEvent.confidence == null ? "N/A" : `${selectedEvent.confidence}%`],
        ["Description", selectedEvent.description || "No description available."],
        ["Explanation", selectedEvent.explanation || "No explanation available."],
        ["Recommendation", selectedEvent.recommendation || "No recommendation available."]
    ];

    details.forEach(([label, value]) => {
        const block = document.createElement("div");
        block.style.cssText = "padding:12px 0;border-bottom:1px solid rgba(56,189,248,.12);";
        const title = document.createElement("div");
        title.textContent = label;
        title.style.cssText = "margin-bottom:5px;color:#63cfff;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;";
        const content = document.createElement("div");
        content.textContent = value == null || value === "" ? "—" : String(value);
        content.style.cssText = "color:#d0deeb;font-size:13px;line-height:1.65;overflow-wrap:anywhere;white-space:pre-wrap;";
        block.append(title, content);
        panel.appendChild(block);
    });

    const downloadReport = document.createElement("a");
    downloadReport.id = "vappDownloadForensicReport";
    downloadReport.href = `/report/forensic/${encodeURIComponent(selectedEvent.id)}`;
    downloadReport.textContent = "Download Forensic PDF";
    downloadReport.style.cssText = "display:inline-block;box-sizing:border-box;margin-top:18px;margin-right:10px;padding:11px 18px;border-radius:9px;background:linear-gradient(135deg,#087fc4,#075985);color:white;font-weight:800;text-decoration:none;text-align:center;";
    downloadReport.setAttribute("aria-label", `Download forensic PDF for event ${selectedEvent.id}`);
    panel.appendChild(downloadReport);

    const closeBottom = document.createElement("button");
    closeBottom.type = "button";
    closeBottom.textContent = "Close details";
    closeBottom.style.cssText = "margin-top:18px;padding:11px 18px;border:0;border-radius:9px;background:linear-gradient(135deg,#00a884,#087fc4);color:white;font-weight:800;cursor:pointer;";
    panel.appendChild(closeBottom);
    modal.appendChild(panel);
    document.body.appendChild(modal);

    const closeModal = () => {
        document.removeEventListener("keydown", onKeyDown);
        modal.remove();
    };
    const onKeyDown = keyEvent => {
        if (keyEvent.key === "Escape") closeModal();
    };
    closeTop.addEventListener("click", closeModal);
    closeBottom.addEventListener("click", closeModal);
    modal.addEventListener("click", clickEvent => {
        if (clickEvent.target === modal) closeModal();
    });
    document.addEventListener("keydown", onKeyDown);
    closeTop.focus();
}

function showVappToast(message, isError = false) {
    document.getElementById("vappToast")?.remove();
    const toast = document.createElement("div");
    toast.id = "vappToast";
    toast.setAttribute("role", isError ? "alert" : "status");
    toast.textContent = message;
    toast.style.cssText = `
        position:fixed; right:22px; bottom:22px; z-index:100000;
        max-width:min(420px,calc(100vw - 44px)); padding:14px 18px;
        border-radius:10px; color:#effaff; font-size:13px; line-height:1.5;
        background:${isError ? "#481d27" : "#0b2c3b"};
        border:1px solid ${isError ? "#ef4444" : "#38bdf8"};
        box-shadow:0 12px 35px rgba(0,0,0,.4);
    `;
    document.body.appendChild(toast);
    window.setTimeout(() => toast.remove(), 4500);
}


function updateCommunicationActivity(events) {
    const rows = Array.isArray(events) ? events : [];
    const bins = Array(12).fill(0);
    const riskBins = {LOW:0, MEDIUM:0, HIGH:0, CRITICAL:0};
    let emailCount = 0, smsCount = 0, flaggedCount = 0;
    const datedEvents = [];

    const isEmail = e => String(e.protocol || "").toUpperCase() === "EMAIL" ||
        /email/i.test(String(e.event_type || ""));
    const isSms = e => String(e.protocol || "").toUpperCase() === "SMS" ||
        /sms/i.test(String(e.event_type || ""));

    rows.forEach(e => {
        if (isEmail(e)) emailCount++;
        if (isSms(e)) smsCount++;

        const level = getEventRisk(e) || "LOW";
        if (Object.prototype.hasOwnProperty.call(riskBins, level)) riskBins[level]++;
        if (isThreatEvent(e)) flaggedCount++;

        const raw = String(e.timestamp || "").replace(" ", "T");
        const time = new Date(raw);
        if (!Number.isNaN(time.getTime())) datedEvents.push(time.getTime());
    });

    // Distribute every stored event across the full recorded history,
    // from the earliest saved event to the most recent saved event.
    const timestamps = rows.map(e => new Date(String(e.timestamp || "").replace(" ", "T")).getTime())
        .filter(value => Number.isFinite(value));
    if (timestamps.length) {
        const firstTime = Math.min(...timestamps);
        const lastTime = Math.max(...timestamps);
        const duration = Math.max(1, lastTime - firstTime);
        rows.forEach(e => {
            const time = new Date(String(e.timestamp || "").replace(" ", "T")).getTime();
            if (!Number.isFinite(time)) return;
            const index = Math.min(11, Math.floor(((time - firstTime) / duration) * 12));
            bins[index]++;
        });
    }

    const maxBin = Math.max(1, ...bins);
    const signalBars = document.getElementById("signalBars");
    if (signalBars) {
        signalBars.innerHTML = bins.map(value =>
            `<b title="${value} event(s)" style="--h:${Math.max(3, value / maxBin * 100)}%"></b>`
        ).join("");
    }

    const riskValues = [riskBins.LOW, riskBins.MEDIUM, riskBins.HIGH, riskBins.CRITICAL];
    const maxRisk = Math.max(1, ...riskValues);
    const intensityBars = document.getElementById("intensityBars");
    if (intensityBars) {
        intensityBars.innerHTML = riskValues.map((value, index) =>
            `<b title="${["Low","Medium","High","Critical"][index]}: ${value}" style="--h:${Math.max(3, value / maxRisk * 100)}%"></b>`
        ).join("");
    }

    const total = rows.length;
    const otherCount = Math.max(0, total - emailCount - smsCount);
    const flaggedPercent = total ? Math.round(flaggedCount / total * 100) : 0;
    const setText = (id, value) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
    };
    setText("emailGaugeValue", emailCount);
    setText("emailGaugeLabel", `${emailCount} RECORDS`);
    setText("smsGaugeValue", smsCount);
    setText("smsGaugeLabel", `${smsCount} RECORDS`);
    setText("flaggedGaugeValue", `${flaggedPercent}%`);
    setText("flowEmailCount", emailCount);
    setText("flowSmsCount", smsCount);

    const emailGauge = document.getElementById("emailGauge");
    const smsGauge = document.getElementById("smsGauge");
    const flaggedGauge = document.getElementById("flaggedGauge");
    if (emailGauge) emailGauge.style.setProperty("--gauge-value", `${total ? emailCount / total * 100 : 0}%`);
    if (smsGauge) smsGauge.style.setProperty("--gauge-value", `${total ? smsCount / total * 100 : 0}%`);
    if (flaggedGauge) flaggedGauge.style.setProperty("--gauge-value", `${flaggedPercent}%`);

    const board = document.querySelector(".cyber-intel-board");
    if (board) {
        board.setAttribute("aria-label",
            `Communication event activity from stored records. ${emailCount} email events, ${smsCount} SMS events, ${otherCount} other events, ${total} total events, ${flaggedCount} flagged events.`);
    }
}

function renderAll(events) {
    currentEvents = Array.isArray(events) ? events : [];
    const viewEvents = getViewEvents(currentEvents);
    updateCommunicationActivity(viewEvents);
    const filter = (document.getElementById("eventFilter")?.value || "").toLowerCase();

    const filtered = viewEvents.filter(e => {
        const hay = [
            e.id, e.source_ip, e.event_type, e.threat_type,
            e.risk_level, e.description, e.timestamp
        ].join(" ").toLowerCase();
        return !filter || hay.includes(filter);
    });

    const recent = filtered.slice(0,10);
    const table = document.getElementById("eventTable");
    if (table) {
        table.innerHTML = recent.map(e => `
            <tr>
                <td>${esc(formatVappTimestamp(e.timestamp))}</td>
                <td>${esc(e.source_ip)}</td>
                <td>${esc(e.event_type)}</td>
                <td>${esc(e.threat_type)}</td>
                <td>${esc(e.confidence)}%</td>
                <td>${esc(e.risk_score)}</td>
                <td><span class="badge ${riskClass(e.risk_level)}">${esc(e.risk_level)}</span></td>
            </tr>`).join("") || `<tr><td colspan="7">No events recorded.</td></tr>`;
    }

    const allTable = document.getElementById("allEventTable");
    if (allTable) {
        allTable.innerHTML = filtered.map(e => `
            <tr class="event-row" data-event-id="${esc(e.id)}" style="cursor:pointer" title="Click to view event details">
                <td>#${esc(e.id)}</td>
                <td>${esc(formatVappTimestamp(e.timestamp))}</td>
                <td>${esc(e.source_ip)}</td>
                <td>${esc(e.event_type)}</td>
                <td>${esc(e.threat_type)}</td>
                <td>${esc(e.risk_score)}</td>
                <td><span class="badge ${riskClass(e.risk_level)}">${esc(e.risk_level)}</span></td>
            </tr>`).join("") || `<tr><td colspan="7">No matching events.</td></tr>`;

        // Attach once to the table itself. The rows can refresh every 3 seconds.
        if (!allTable.dataset.detailsHandlerAttached) {
            allTable.dataset.detailsHandlerAttached = "true";
            allTable.addEventListener("click", event => {
                const row = event.target.closest(".event-row");
                if (!row || !allTable.contains(row)) return;

                const selectedEvent = currentEvents.find(
                    item => String(item.id) === row.dataset.eventId
                );
                if (selectedEvent) showEventDetails(selectedEvent);
            });
        }
    }

    const threats = viewEvents.filter(isThreatEvent);
    const incidents = viewEvents.filter(e => ["HIGH", "CRITICAL"].includes(getEventRisk(e)));
    const medium = viewEvents.filter(e => getEventRisk(e) === "MEDIUM");
    const normal = viewEvents.filter(isNormalEvent);

    document.getElementById("totalEvents").textContent = viewEvents.length;
    document.getElementById("totalThreats").textContent = threats.length;
    document.getElementById("highRisk").textContent = incidents.length;

    document.getElementById("analyticsTotal").textContent = viewEvents.length;
    document.getElementById("analyticsThreatRate").textContent =
        viewEvents.length ? Math.round(threats.length/viewEvents.length*100) + "%" : "0%";
    document.getElementById("analyticsHigh").textContent = incidents.length;
    document.getElementById("analyticsNormal").textContent = normal.length;

    document.getElementById("reportEvents").textContent = viewEvents.length;
    document.getElementById("reportThreats").textContent = threats.length;
    document.getElementById("reportHigh").textContent = incidents.length;

    document.getElementById("threatModuleCount").textContent = threats.length;
    document.getElementById("threatHighCount").textContent = incidents.length;
    document.getElementById("threatMediumCount").textContent = medium.length;
    document.getElementById("latestThreatName").textContent = threats[0]?.threat_type || "—";

    const counts = {brute:0, scan:0, suspicious:0, normal:normal.length};
    threats.forEach(e => {
        const t = String(e.threat_type || "").toLowerCase();
        if (t.includes("brute")) counts.brute++;
        else if (t.includes("scan")) counts.scan++;
        else counts.suspicious++;
    });
    const total = viewEvents.length || 1;
    document.getElementById("bruteCount").textContent = counts.brute;
    document.getElementById("scanCount").textContent = counts.scan;
    document.getElementById("suspiciousCount").textContent = counts.suspicious;
    document.getElementById("normalCount").textContent = counts.normal;
    document.getElementById("bruteBar").style.width = counts.brute/total*100 + "%";
    document.getElementById("scanBar").style.width = counts.scan/total*100 + "%";
    document.getElementById("suspiciousBar").style.width = counts.suspicious/total*100 + "%";
    document.getElementById("normalBar").style.width = counts.normal/total*100 + "%";

    const donutTotal = viewEvents.length || 1;
    const donutParts = [counts.brute, counts.scan, counts.suspicious, counts.normal];
    const donutColors = ["#327cff", "#ff9a22", "#963cff", "#20dda4"];
    let donutOffset = 0;
    const donutStops = donutParts.map((value, index) => {
        const start = donutOffset;
        donutOffset += value / donutTotal * 100;
        return `${donutColors[index]} ${start}% ${donutOffset}%`;
    });
    const donut = document.getElementById("threatDonut");
    if (donut) donut.style.background = `conic-gradient(${donutStops.join(",")})`;
    ["brute", "scan", "suspicious", "normal"].forEach((key, index) => {
        const percent = document.getElementById(key + "Percent");
        if (percent) percent.textContent = Math.round(donutParts[index] / donutTotal * 100) + "%";
    });

    document.getElementById("threatTable").innerHTML = threats.map(e => `
        <tr>
            <td>${esc(formatVappTimestamp(e.timestamp))}</td>
            <td>${esc(e.source_ip)}</td>
            <td>${esc(e.threat_type)}</td>
            <td>${esc(e.confidence)}%</td>
            <td>${esc(e.risk_score)}</td>
            <td><span class="badge ${riskClass(e.risk_level)}">${esc(e.risk_level)}</span></td>
        </tr>`).join("") || `<tr><td colspan="6">No threats detected.</td></tr>`;

    document.getElementById("incidentList").innerHTML = incidents.map(e => `
        <div class="incident">
            <strong>🚨 INCIDENT #${esc(e.id)} — ${esc(e.threat_type)}</strong><br>
            <span style="font-size:10px;color:#9fb2c5">
                Source: ${esc(e.source_ip)} &nbsp;|&nbsp;
                Risk: ${esc(e.risk_level)} &nbsp;|&nbsp;
                Score: ${esc(e.risk_score)}
            </span>
            <p style="font-size:10px;color:#b8cad9">${esc(e.explanation)}</p>
            <p style="font-size:10px;color:#6ee7a0">🛡️ ${esc(e.recommendation)}</p>
        </div>`).join("") || `<div style="color:#7890a8;font-size:10px">No high-risk incidents recorded.</div>`;

    if (viewEvents[0]) updateAI(viewEvents[0]);
}

async function loadEvents() {
    try {
        // /api/events returns the complete event history for the signed-in account.
        const response = await fetch("/api/events", {cache:"no-store"});
        const data = await response.json();
        if (data.success) renderAll(data.events);
    } catch (error) {
        console.error("VAPP event refresh:", error);
    }
}

async function simulate(type) {
    try {
        const response = await fetch("/simulate/" + type, {method:"POST"});
        const data = await response.json();
        if (!data.success) throw new Error(data.message || "Simulation failed.");
        updateAI({
            threat_type:data.threat_type, source_ip:data.source_ip,
            confidence:data.confidence, risk_score:data.risk_score,
            risk_level:data.risk_level, timestamp:data.timestamp,
            explanation:data.explanation, recommendation:data.recommendation
        });
        await loadEvents();
    } catch(e) {
        showVappToast("VAPP could not process the event: " + e.message, true);
    }
}

async function analyzeLiveEmail() {
    const button = document.getElementById("emailAnalyzeButton");
    const result = document.getElementById("emailResult");
    const error = document.getElementById("emailError");
    const payload = {
        sender: document.getElementById("emailSender").value.trim(),
        source_ip: document.getElementById("emailSourceIP").value.trim(),
        subject: document.getElementById("emailSubject").value.trim(),
        body: document.getElementById("emailBody").value.trim()
    };

    error.style.display = "none";
    result.style.display = "none";

    if (!payload.sender || !payload.subject || !payload.body) {
        error.textContent = "Sender, subject and message content are required.";
        error.style.display = "block";
        return;
    }

    button.disabled = true;
    button.textContent = "⏳ VAPP ANALYZING...";

    try {
        const response = await fetch("/api/email-event", {
            method:"POST",
            headers:{"Content-Type":"application/json"},
            body:JSON.stringify(payload)
        });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || "Email analysis failed.");

        document.getElementById("emailThreatType").textContent = data.threat_type;
        document.getElementById("emailConfidence").textContent = data.confidence + "%";
        document.getElementById("emailRiskScore").textContent = data.risk_score;
        document.getElementById("emailDetectedIP").textContent = data.source_ip;
        document.getElementById("emailEventID").textContent = "#" + data.event_id;
        document.getElementById("emailStatus").textContent = data.status;
        document.getElementById("emailRiskBadge").textContent = data.risk_level + " RISK";
        document.getElementById("emailIndicators").textContent =
            data.matched_indicators?.length ? data.matched_indicators.join(", ") : "No keyword indicators";
        document.getElementById("emailExplanation").textContent = data.explanation;
        document.getElementById("emailRecommendation").textContent = data.recommendation;
        result.style.display = "block";
        await loadEvents();
        result.scrollIntoView({behavior:"smooth",block:"center"});
        showVappToast(`VAPP analyzed the email: ${data.threat_type} · ${data.risk_level} risk · Event #${data.event_id}`);
    } catch(e) {
        error.textContent = "VAPP could not analyze the email: " + e.message;
        error.style.display = "block";
    } finally {
        button.disabled = false;
        button.textContent = "🔍 ANALYZE INCOMING EMAIL";
    }
}

async function importSmsCsv(event) {
    event.preventDefault();
    const fileInput = document.getElementById("smsCsvFile");
    const button = document.getElementById("smsImportButton");
    const status = document.getElementById("smsImportStatus");
    const resultsPanel = document.getElementById("smsImportResults");
    const resultsTable = document.getElementById("smsResultsTable");
    const file = fileInput.files && fileInput.files[0];

    status.className = "sms-status";
    status.style.display = "none";
    resultsPanel.style.display = "none";
    resultsTable.innerHTML = "";

    if (!file) {
        status.textContent = "Please choose a CSV file first.";
        status.className = "sms-status error";
        return;
    }
    if (!file.name.toLowerCase().endsWith(".csv")) {
        status.textContent = "Please select a file with the .csv extension.";
        status.className = "sms-status error";
        return;
    }

    const formData = new FormData();
    formData.append("file", file);
    button.disabled = true;
    button.textContent = "⏳ ANALYZING SMS...";
    status.style.display = "block";
    status.textContent = "Uploading CSV and analyzing messages...";

    try {
        const response = await fetch("/api/sms-import", {method:"POST", body:formData});
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || "SMS import failed.");

        status.textContent = `${data.message || "SMS import completed."} Skipped empty rows: ${data.skipped ?? 0}.`;
        status.className = "sms-status success";
        resultsTable.innerHTML = (data.results || []).map(item => `
            <tr>
                <td>#${esc(item.event_id)}</td>
                <td>${esc(item.sender)}</td>
                <td>${esc(item.threat_type)}</td>
                <td>${esc(item.confidence)}%</td>
                <td>${esc(item.risk_score)}</td>
                <td><span class="badge ${riskClass(item.risk_level)}">${esc(item.risk_level)}</span></td>
            </tr>`).join("") || `<tr><td colspan="6">No non-empty SMS messages were found.</td></tr>`;
        resultsPanel.style.display = "block";
        await loadEvents();
        showVappToast(`SMS import complete: ${data.processed} message(s) analyzed and saved.`);
    } catch (error) {
        status.textContent = "VAPP could not import the SMS CSV: " + error.message;
        status.className = "sms-status error";
    } finally {
        button.disabled = false;
        button.textContent = "📥 IMPORT & ANALYZE SMS";
    }
}

document.getElementById("smsImportForm")?.addEventListener("submit", importSmsCsv);

function performSearch(event) {
    event.preventDefault();
    const q = document.getElementById("globalSearch").value.trim().toLowerCase();
    const filtered = currentEvents.filter(e =>
        [e.source_ip,e.event_type,e.threat_type,e.risk_level,e.description,e.timestamp]
        .join(" ").toLowerCase().includes(q)
    );
    const eventFilter = document.getElementById("eventFilter");
    if (eventFilter) eventFilter.value = q;
    renderAll(currentEvents);
    document.getElementById("event-logs").scrollIntoView({behavior:"smooth"});
    return false;
}

function toggleRefresh() {
    refreshEnabled = !refreshEnabled;
    document.getElementById("refreshToggle").textContent = refreshEnabled ? "ON" : "OFF";
}


async function loadGmailStatus() {
    const account = document.getElementById("gmailAccountStatus");
    const message = document.getElementById("gmailControlStatus");
    const connect = document.getElementById("gmailConnectButton");
    const start = document.getElementById("gmailStartButton");
    const stop = document.getElementById("gmailStopButton");
    const disconnect = document.getElementById("gmailDisconnectButton");
    if (!account) return;
    try {
        const response = await fetch("/api/gmail-status", {credentials:"same-origin"});
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || "Status unavailable");
        if (data.connected) {
            account.textContent = data.email || "Connected";
            connect.textContent = "RECONNECT GMAIL";
            start.disabled = !!data.monitoring;
            stop.disabled = !data.monitoring;
            disconnect.disabled = false;
            message.textContent = data.monitoring ? "Gmail connected — monitoring is running for this account." : "Gmail connected — monitoring is currently stopped.";
        } else {
            account.textContent = "Not connected";
            connect.textContent = "CONNECT GMAIL";
            start.disabled = true;
            stop.disabled = true;
            disconnect.disabled = true;
            message.textContent = "Connect your own Gmail account to enable mailbox monitoring.";
        }
    } catch (error) {
        account.textContent = "Status unavailable";
        message.textContent = "Could not retrieve Gmail status: " + error.message;
    }
}

async function gmailControl(action) {
    const message = document.getElementById("gmailControlStatus");
    const labels = {start:"Starting Gmail monitoring…", stop:"Stopping Gmail monitoring…", disconnect:"Disconnecting Gmail…"};
    if (action === "disconnect" && !window.confirm("Disconnect this Gmail account from VAPP?")) return;
    message.textContent = labels[action] || "Processing…";
    try {
        const response = await fetch(`/api/gmail/${action}`, {
            method:"POST",
            credentials:"same-origin",
            headers:{"Content-Type":"application/json"},
            body:"{}"
        });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || "Request failed");
        message.textContent = data.message || "Request completed.";
        await loadGmailStatus();
        if (action === "start") setTimeout(loadGmailStatus, 1200);
    } catch (error) {
        message.textContent = "Gmail action failed: " + error.message;
    }
}

loadGmailStatus();
setInterval(loadGmailStatus, 10000);

setCommunicationView("all");

setInterval(() => {
    if (refreshEnabled) loadEvents();
}, 3000);

loadEvents();
</script>

</body>
</html>
